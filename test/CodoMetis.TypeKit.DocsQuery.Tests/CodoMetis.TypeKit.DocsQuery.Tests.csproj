<Project Sdk="Microsoft.NET.Sdk">

    <!-- docs-query's tests: synthetic corpora in temporary checkouts, and the repository's own docs. -->
    <ItemGroup>
        <ProjectReference Include="..\..\tools\DocsQuery\DocsQuery.csproj" />
    </ItemGroup>

    <!-- The stale-tool test runs the built docs-query.dll from a throwaway repository (ToolSandbox.cs); ToolOutput says where the output is. -->
    <ItemGroup>
        <Compile Include="../CodoMetis.TypeKit.BuildVerdict.Tests/ToolSandbox.cs" Link="ToolSandbox.cs" />
        <AssemblyAttribute Include="System.Reflection.AssemblyMetadataAttribute">
            <_Parameter1>ToolOutput</_Parameter1>
            <_Parameter2>$([System.IO.Path]::GetFullPath('$(MSBuildThisFileDirectory)../../tools/DocsQuery/bin/$(Configuration)/$(TargetFramework)/'))</_Parameter2>
        </AssemblyAttribute>
    </ItemGroup>

</Project>
