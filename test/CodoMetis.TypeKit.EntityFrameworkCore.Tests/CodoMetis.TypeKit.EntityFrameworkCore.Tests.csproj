<Project Sdk="Microsoft.NET.Sdk">

    <!--
      The EF satellite against value objects the real generators wove: the probes, and the model's own
      identifiers, which this project gets through the probes' transitive fabric. The PostgreSQL and SQL
      Server tests start a container, so they need Docker.
    -->
    <ItemGroup>
        <ProjectReference Include="..\..\src\CodoMetis.TypeKit.EntityFrameworkCore\CodoMetis.TypeKit.EntityFrameworkCore.csproj" />
        <ProjectReference Include="..\CodoMetis.TypeKit.Generators.Probes\CodoMetis.TypeKit.Generators.Probes.csproj" />
    </ItemGroup>

    <ItemGroup>
        <PackageReference Include="Microsoft.EntityFrameworkCore.Sqlite" />
        <!-- Writes a migration snapshot as `dotnet ef migrations add` does; Roslyn compiles it back into a model. -->
        <PackageReference Include="Microsoft.EntityFrameworkCore.Design" />
        <PackageReference Include="Microsoft.CodeAnalysis.CSharp" />
        <PackageReference Include="Npgsql.EntityFrameworkCore.PostgreSQL" />
        <PackageReference Include="Microsoft.EntityFrameworkCore.SqlServer" />
        <!-- Past the advisories of the 9.0.11 Microsoft.Data.SqlClient brings; see Directory.Packages.props. -->
        <PackageReference Include="System.Security.Cryptography.Pkcs" />
        <PackageReference Include="Testcontainers.PostgreSql" />
        <!-- SQL Server as a plain container (SqlServer.cs): the module waits through sqlcmd, which Azure SQL Edge has not. -->
        <PackageReference Include="Testcontainers" />
    </ItemGroup>

</Project>
