<Project Sdk="Microsoft.NET.Sdk">

    <!--
      The EF satellite against value objects the real generators wove: the probes, and the model's own
      identifiers, which this project gets through the probes' transitive fabric. The PostgreSQL and SQL
      Server tests start a container, so they need Docker.
    -->
    <ItemGroup>
        <ProjectReference Include="..\..\src\CodoMetis.TypeKit.EntityFrameworkCore\CodoMetis.TypeKit.EntityFrameworkCore.csproj" />
        <ProjectReference Include="..\CodoMetis.TypeKit.Generators.Probes\CodoMetis.TypeKit.Generators.Probes.csproj" />
    </ItemGroup>

    <ItemGroup>
        <PackageReference Include="Microsoft.EntityFrameworkCore.Sqlite" />
        <!-- Writes a migration snapshot as `dotnet ef migrations add` does; Roslyn compiles it back into a model. -->
        <PackageReference Include="Microsoft.EntityFrameworkCore.Design" />
        <PackageReference Include="Microsoft.CodeAnalysis.CSharp" />
        <PackageReference Include="Npgsql.EntityFrameworkCore.PostgreSQL" />
        <PackageReference Include="Microsoft.EntityFrameworkCore.SqlServer" />
        <!-- Past the advisories of the 9.0.11 Microsoft.Data.SqlClient brings; see Directory.Packages.props. -->
        <PackageReference Include="System.Security.Cryptography.Pkcs" />
        <PackageReference Include="Testcontainers.PostgreSql" />
        <!-- SQL Server as a plain container (SqlServer.cs): the module waits through sqlcmd, which Azure SQL Edge has not. -->
        <PackageReference Include="Testcontainers" />
    </ItemGroup>

    <!--
      parallelMode "all": every row of a theory runs in parallel, not only the test classes (xunit.v3 4.x). The two
      query sweeps are one class each of 12,275 rows, which the default mode ran one after another, and a row
      waits on SQLite, SQL Server or PostgreSQL more than it computes: at four threads the project took 55 s
      instead of 123 s for the same CPU (#251). A row only reads what was seeded for its model, each SQLite class
      opens its own database per test, and the PostgreSQL round trips read back only the rows they saved.
      SqlServerRoundTripTests creates the same tables in one database from each of its tests, so it opts out
      ([TestClass(DisableParallelization = true)]).
    -->
    <ItemGroup>
        <None Update="xunit.runner.json" CopyToOutputDirectory="PreserveNewest" />
    </ItemGroup>

</Project>
