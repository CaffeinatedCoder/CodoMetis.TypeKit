<Project Sdk="Microsoft.NET.Sdk">

    <!--
      Every C# block of the READMEs, as compiled code: each sits between `// sample: {README}/{name}`
      and `// end sample`, with what it assumes (the types it names, the variables it uses) outside
      the region. ReadmeSampleTests (conventions) holds each README block to exactly one region, so a
      README edit that is not mirrored here fails there, and a sample that stops compiling fails this
      build. Where a sample states an output in a comment, a test beside the region asserts it.

      It references the shipping projects as a consumer's projects reference the packages: the
      generators where the value objects are declared, both satellites, and
      Microsoft.AspNetCore.OpenApi directly, as the ASP.NET Core README says a host must. The analyzer
      runs as it does for a consumer, so a sample that trips a rule it does not show fails the build;
      one that shows a rule suppresses it around its region.

      The samples' namespaces are outside CodoMetis.TypeKit on purpose: inside it, the enclosing
      namespace would supply Option, Result and OrderId.New() to a sample whose README forgot the using.
    -->
    <ItemGroup>
        <FrameworkReference Include="Microsoft.AspNetCore.App" />
        <PackageReference Include="Microsoft.AspNetCore.OpenApi" />
        <PackageReference Include="Microsoft.AspNetCore.TestHost" />
        <PackageReference Include="Serilog.Sinks.Console" />
        <PackageReference Include="Npgsql.EntityFrameworkCore.PostgreSQL" />
        <PackageReference Include="Microsoft.EntityFrameworkCore.Sqlite" />
        <PackageReference Include="NodaTime.Serialization.SystemTextJson" />
    </ItemGroup>

    <ItemGroup>
        <ProjectReference Include="..\..\src\CodoMetis.TypeKit.Generators\CodoMetis.TypeKit.Generators.csproj" />
        <ProjectReference Include="..\..\src\CodoMetis.TypeKit.EntityFrameworkCore\CodoMetis.TypeKit.EntityFrameworkCore.csproj" />
        <ProjectReference Include="..\..\src\CodoMetis.TypeKit.AspNetCore\CodoMetis.TypeKit.AspNetCore.csproj" />
        <ProjectReference Include="..\..\src\CodoMetis.TypeKit.Testing\CodoMetis.TypeKit.Testing.csproj" />
        <ProjectReference Include="..\..\src\CodoMetis.TypeKit.Serilog\CodoMetis.TypeKit.Serilog.csproj" />
        <ProjectReference Include="..\..\src\CodoMetis.TypeKit.Analyzers\CodoMetis.TypeKit.Analyzers.csproj" OutputItemType="Analyzer" ReferenceOutputAssembly="false" />
    </ItemGroup>

    <!--
      For the analyzer probes of tools/probe/corpus (CMTK0010, CMTK0014): they run the CMTK analyzers
      in-process over a CSharpCompilation, as the analyzer tests do, so the analyzer assembly is also
      referenced as a library, with the compiler it runs on. The type-argument variant catalogues are
      the analyzer tests' own, compiled in rather than copied, so a site the catalogue gains reaches
      the probes too.
    -->
    <ItemGroup>
        <ProjectReference Include="..\..\src\CodoMetis.TypeKit.Analyzers\CodoMetis.TypeKit.Analyzers.csproj" />
        <PackageReference Include="Microsoft.CodeAnalysis.CSharp" />
        <Compile Include="..\CodoMetis.TypeKit.Analyzers.Tests\Variants\TypeArgumentSites.cs" Link="Variants\TypeArgumentSites.cs" />
        <Compile Include="..\CodoMetis.TypeKit.Analyzers.Tests\Variants\TypeArgumentKinds.cs" Link="Variants\TypeArgumentKinds.cs" />
    </ItemGroup>

    <!--
      The probes' side (1), the framework without TypeKit, is read from a fact's fixture where one covers a row (the harness's Sides,
      design/adr/0107): the facts' reader is compiled in as it is, BCL only, rather than the Facts project referenced, which is a test
      project of its own and references no TypeKit project. The fixtures are read from the repository, beside the facts' tests.
    -->
    <ItemGroup>
        <Compile Include="..\CodoMetis.TypeKit.Facts\FactFixture.cs" Link="Facts\FactFixture.cs" />
    </ItemGroup>

</Project>
