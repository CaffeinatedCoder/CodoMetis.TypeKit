<Project Sdk="Microsoft.NET.Sdk">

    <!--
      The executable half of the verified facts in design/knowledge/ (design/adr/0093): one test class per
      fact a test can observe, named by its KB id, asserting what a framework does on its own. It references
      no TypeKit project (NoTypeKitTests), so a test here fails only when a framework changes, and that
      failure is the trigger to re-verify the entry.
    -->
    <!--
      ASP.NET's OpenAPI XML-comment generator intercepts AddOpenApi, as it does in any documented
      host. The Web SDK enables its interceptors namespace; this project uses the plain SDK.
    -->
    <PropertyGroup>
        <InterceptorsNamespaces>$(InterceptorsNamespaces);Microsoft.AspNetCore.OpenApi.Generated</InterceptorsNamespaces>
    </PropertyGroup>

    <ItemGroup>
        <FrameworkReference Include="Microsoft.AspNetCore.App" />
        <PackageReference Include="Microsoft.AspNetCore.OpenApi" />
        <PackageReference Include="Microsoft.AspNetCore.TestHost" />
        <!--
          The PostgreSQL facts, with plain EF Core and Npgsql; they run where TYPEKIT_PG names a server (PgFactHost).
          Relational is named so that EF Core is the version the facts pin, not the older floor the provider brings.
        -->
        <PackageReference Include="Microsoft.EntityFrameworkCore.Relational" />
        <PackageReference Include="Npgsql.EntityFrameworkCore.PostgreSQL" />
        <PackageReference Include="Microsoft.EntityFrameworkCore.Sqlite" />
        <!--
          The SQL Server facts, in a container (SqlServerFactHost), with the trait Needs=Docker; SqlClient's advisories
          are answered as in the EF tests (Directory.Packages.props).
        -->
        <PackageReference Include="Microsoft.EntityFrameworkCore.SqlServer" />
        <PackageReference Include="System.Security.Cryptography.Pkcs" />
        <PackageReference Include="Testcontainers" />
    </ItemGroup>

    <!-- A fact's measured answers as data, beside its test (FactFixture, design/adr/0107), read from the test output. -->
    <ItemGroup>
        <None Update="KB*.fixture.json" CopyToOutputDirectory="PreserveNewest" />
    </ItemGroup>

    <ItemGroup>
        <Using Include="System.Text.Json" />
        <Using Include="System.Text.Json.Nodes" />
    </ItemGroup>

</Project>
