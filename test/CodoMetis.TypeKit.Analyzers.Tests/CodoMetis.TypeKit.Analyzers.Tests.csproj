<Project Sdk="Microsoft.NET.Sdk">

    <!--
      Verifier tests for the CMTK analyzers. The analyzer is referenced as a library, because the
      verifier instantiates it in-process; OutputItemType=Analyzer would instead run it over this
      project's own sources. CodoMetis.TypeKit is referenced so that every verifier compilation binds
      to the real contracts (AnalyzerTest), and the EF Core satellite so that CMTK0004 binds to the
      real ValueObjectConverter.
    -->
    <ItemGroup>
        <ProjectReference Include="..\..\src\CodoMetis.TypeKit.Analyzers\CodoMetis.TypeKit.Analyzers.csproj" />
        <ProjectReference Include="..\..\src\CodoMetis.TypeKit.Analyzers\CodeFixes\CodoMetis.TypeKit.Analyzers.CodeFixes.csproj" />
        <ProjectReference Include="..\..\src\CodoMetis.TypeKit\CodoMetis.TypeKit.csproj" />
        <ProjectReference Include="..\..\src\CodoMetis.TypeKit.EntityFrameworkCore\CodoMetis.TypeKit.EntityFrameworkCore.csproj" />
        <ProjectReference Include="..\..\src\CodoMetis.TypeKit.Testing\CodoMetis.TypeKit.Testing.csproj" />
    </ItemGroup>

    <ItemGroup>
        <PackageReference Include="Microsoft.CodeAnalysis.CSharp.Analyzer.Testing" />
        <PackageReference Include="Microsoft.CodeAnalysis.CSharp.CodeFix.Testing" />
        <PackageReference Include="Microsoft.CodeAnalysis.CSharp.Workspaces" />
        <!-- Past the advisories of the 9.0.6 NuGet.Packaging brings; see Directory.Packages.props. -->
        <PackageReference Include="System.Security.Cryptography.Pkcs" />
    </ItemGroup>

    <!--
      parallelMode "all": every row of a theory runs in parallel, not only the test classes (xunit.v3 4.x). Each
      variant sweep is one class of hundreds to thousands of rows, which the default mode ran one after another:
      DroppedTaskVariantTests alone kept CI's test step going for two to seven minutes after every other test
      project had finished (#245). Every test here builds its own compilation and shares nothing with another, so
      none opts out.
    -->
    <ItemGroup>
        <None Update="xunit.runner.json" CopyToOutputDirectory="PreserveNewest" />
    </ItemGroup>

</Project>
