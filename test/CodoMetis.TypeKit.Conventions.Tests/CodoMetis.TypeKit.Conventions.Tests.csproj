<Project Sdk="Microsoft.NET.Sdk">

    <!--
      Repository-level rules that are about packaging and boundaries rather than code. It reads
      the restore output of the shipping projects instead of referencing them, so no shipping
      dependency (Metalama above all) flows into this project. The one rule about code reads the
      generators' sources as syntax, with Roslyn, for the same reason.
    -->
    <ItemGroup>
        <PackageReference Include="Microsoft.CodeAnalysis.CSharp" />
    </ItemGroup>

    <!--
      CiLaneTests runs the built ci-lanes.dll's `classify` over the files MSBuild evaluates for the packages. The
      reference only orders the build; CiLanesOutput says where the output is.
    -->
    <ItemGroup>
        <ProjectReference Include="../../tools/CiLanes/CiLanes.csproj" ReferenceOutputAssembly="false" />
        <AssemblyAttribute Include="System.Reflection.AssemblyMetadataAttribute">
            <_Parameter1>CiLanesOutput</_Parameter1>
            <_Parameter2>$([System.IO.Path]::GetFullPath('$(MSBuildThisFileDirectory)../../tools/CiLanes/bin/$(Configuration)/$(TargetFramework)/'))</_Parameter2>
        </AssemblyAttribute>
    </ItemGroup>

    <!--
      The rules read the whole repository by path (its files, its index, every project's sources and evaluation), so a
      change anywhere reaches these tests and every narrowed suite runs them (tools/CiLanes, design/adr/0127).
    -->
    <ItemGroup>
        <ReadsByPath Include="../../" />
    </ItemGroup>

    <!--
      So the build restores the shipping projects itself. Referencing none of them, this project
      restores nothing they need, and a `dotnet test` of this project alone on a fresh checkout ran against no
      src/*/obj/project.assets.json: measured 2026-10-14, 92 of 1144 tests failed in a second (every
      test of the Packs collection, whose pack runs with no restore, and MetalamaBoundaryTests), then
      passed once anything else, the Samples project or a solution build, had restored src/. That read
      as a flaky run. A restore that finds nothing changed writes nothing, so after the solution's own
      restore this one is a no-op and races no build of src/.
    -->
    <Target Name="RestoreShippingProjects" BeforeTargets="Build">
        <ItemGroup>
            <ShippingProject Include="$([MSBuild]::GetDirectoryNameOfFileAbove('$(MSBuildProjectDirectory)', 'CodoMetis.TypeKit.slnx'))/src/*/*.csproj" />
        </ItemGroup>

        <!-- A fresh session id forces a new evaluation, the documented way to restore from inside a build. -->
        <MSBuild Projects="@(ShippingProject)" Targets="Restore" Properties="MSBuildRestoreSessionId=$([System.Guid]::NewGuid())" BuildInParallel="true" />
    </Target>

</Project>
