<Project Sdk="Microsoft.NET.Sdk.Web">
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <!-- The value objects are declared here, so the route analyzer sees them unwoven (spikes/OpenApiSchemas, finding 13). -->
    <NoWarn>$(NoWarn);ASP0020</NoWarn>
  </PropertyGroup>
  <ItemGroup>
    <PackageReference Include="Microsoft.AspNetCore.OpenApi" Version="10.0.12" />
  </ItemGroup>
  <ItemGroup>
    <!-- Real value objects, woven by the real generators. -->
    <ProjectReference Include="../../src/CodoMetis.TypeKit.Generators/CodoMetis.TypeKit.Generators.csproj" />
  </ItemGroup>
</Project>
