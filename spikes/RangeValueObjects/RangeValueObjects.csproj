<Project Sdk="Microsoft.NET.Sdk.Web">
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <!-- -p:RangeSet=true adds a value object over a RangeSet (finding 2). -->
    <DefineConstants Condition="'$(RangeSet)' == 'true'">$(DefineConstants);RANGESET</DefineConstants>
  </PropertyGroup>
  <ItemGroup>
    <PackageReference Include="CodoMetis.ValueRanges" Version="8.0.0" />
    <PackageReference Include="CodoMetis.ValueRanges.EFCore.PostgreSQL" Version="8.0.0" />
    <PackageReference Include="Npgsql.EntityFrameworkCore.PostgreSQL" Version="10.0.3" />
    <PackageReference Include="Microsoft.AspNetCore.OpenApi" Version="10.0.12" />
    <PackageReference Include="Testcontainers.PostgreSql" Version="4.16.0" />
  </ItemGroup>
  <ItemGroup>
    <!-- Real value objects, woven by the real generators, mapped by the real satellite. -->
    <ProjectReference Include="../../src/CodoMetis.TypeKit.Generators/CodoMetis.TypeKit.Generators.csproj" />
    <ProjectReference Include="../../src/CodoMetis.TypeKit.EntityFrameworkCore/CodoMetis.TypeKit.EntityFrameworkCore.csproj" />
    <ProjectReference Include="../../src/CodoMetis.TypeKit.AspNetCore/CodoMetis.TypeKit.AspNetCore.csproj" />
  </ItemGroup>
</Project>
