<Project Sdk="Microsoft.NET.Sdk.Web">
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <!-- Finding 1: the value objects are declared in this project, so the route analyzer sees them unwoven. -->
    <NoWarn>$(NoWarn);ASP0020</NoWarn>
  </PropertyGroup>
  <ItemGroup>
    <!-- Split/ holds the route-analyzer measurement, as projects of its own. -->
    <Compile Remove="Split/**" />
    <Content Remove="Split/**" />
    <None Remove="Split/**" />
  </ItemGroup>
  <ItemGroup>
    <PackageReference Include="Microsoft.AspNetCore.OpenApi" Version="10.0.12" />
    <PackageReference Include="Microsoft.AspNetCore.TestHost" Version="10.0.12" />
    <PackageReference Include="NodaTime" Version="3.3.4" />
    <!-- With it, the generated converter writes NodaTime values through NodaConverters, not the host's options. -->
    <PackageReference Include="NodaTime.Serialization.SystemTextJson" Version="1.4.0" />
  </ItemGroup>
  <ItemGroup>
    <!-- Real value objects, woven by the real generators. -->
    <ProjectReference Include="../../src/CodoMetis.TypeKit.Generators/CodoMetis.TypeKit.Generators.csproj" />
  </ItemGroup>
</Project>
