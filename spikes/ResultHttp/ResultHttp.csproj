<Project Sdk="Microsoft.NET.Sdk.Web">
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
  </PropertyGroup>
  <!--
    -p:Aot=true publishes with Native AOT, which also turns on the Request Delegate Generator. Without
    it the endpoints are compiled at run time by RequestDelegateFactory, with MVC beside them.
  -->
  <PropertyGroup Condition="'$(Aot)' == 'true'">
    <PublishAot>true</PublishAot>
    <DefineConstants>$(DefineConstants);AOT</DefineConstants>
  </PropertyGroup>
  <ItemGroup>
    <PackageReference Include="Microsoft.AspNetCore.OpenApi" Version="10.0.12" />
  </ItemGroup>
  <ItemGroup>
    <!-- The real Option/Result, as a consumer of the base package sees them. -->
    <ProjectReference Include="../../src/CodoMetis.TypeKit/CodoMetis.TypeKit.csproj" />
  </ItemGroup>
</Project>
