<?xml version="1.0" encoding="utf-8"?>
<configuration>
  <!-- nuget.org alone, so the 2.3.1 packages measured are the published ones and no local feed's. -->
  <packageSources>
    <clear />
    <add key="nuget.org" value="https://api.nuget.org/v3/index.json" protocolVersion="3" />
  </packageSources>
</configuration>
