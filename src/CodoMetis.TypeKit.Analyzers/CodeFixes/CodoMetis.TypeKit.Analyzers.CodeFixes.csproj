<Project Sdk="Microsoft.NET.Sdk">

    <!--
      The code fixes of the CMTK rules, in an assembly of their own: a code fix compiles against
      Microsoft.CodeAnalysis.Workspaces, which the command-line compiler does not provide, so an
      analyzer in the same assembly is RS1038. Nested in the analyzer project's folder on purpose:
      it is not a package (the conventions glob src/ for packages), it ships inside
      CodoMetis.TypeKit.Analyzers under analyzers/dotnet/cs, beside the analyzer assembly, and the IDE
      loads both. It references nothing of the analyzer assembly: the ids it fixes are spelled here
      and held to the analyzer's by RequiredParameterlessConstructorAnalyzerTests.
    -->
    <PropertyGroup>
        <TargetFramework>netstandard2.0</TargetFramework>
        <ImplicitUsings>disable</ImplicitUsings>
        <EnforceExtendedAnalyzerRules>true</EnforceExtendedAnalyzerRules>
        <IsRoslynComponent>true</IsRoslynComponent>
        <IsPackable>false</IsPackable>
        <RootNamespace>CodoMetis.TypeKit.Analyzers</RootNamespace>
    </PropertyGroup>

    <ItemGroup>
        <PackageReference Include="Microsoft.CodeAnalysis.CSharp.Workspaces" PrivateAssets="all" />
        <PackageReference Include="Microsoft.CodeAnalysis.Analyzers" PrivateAssets="all" />
    </ItemGroup>

</Project>
