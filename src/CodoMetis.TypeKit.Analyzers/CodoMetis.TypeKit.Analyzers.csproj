<Project Sdk="Microsoft.NET.Sdk">

    <!--
      Roslyn loads analyzers into the compiler's own process, so this targets netstandard2.0 whatever
      the analysed code targets. It reaches consumers through CodoMetis.TypeKit (docs/plan.md §10).
    -->
    <PropertyGroup>
        <TargetFramework>netstandard2.0</TargetFramework>
        <ImplicitUsings>disable</ImplicitUsings>
        <EnforceExtendedAnalyzerRules>true</EnforceExtendedAnalyzerRules>
        <IsRoslynComponent>true</IsRoslynComponent>
        <Description>Analyzers for CodoMetis.TypeKit: no default instances, no ignored results, no validation bypass.</Description>
        <PackageTags>roslyn;analyzers;option;result;value-object;strongly-typed-id;default;ddd</PackageTags>
    </PropertyGroup>

    <!--
      An analyzer-only package: the assembly goes to analyzers/dotnet/cs and nothing to lib/, so a
      consumer never compiles against it. NU5128 is the warning for exactly that missing lib/. It is
      not a development dependency, which would stop it flowing through CodoMetis.TypeKit.
    -->
    <PropertyGroup>
        <IncludeBuildOutput>false</IncludeBuildOutput>
        <SuppressDependenciesWhenPacking>true</SuppressDependenciesWhenPacking>
        <DevelopmentDependency>false</DevelopmentDependency>
        <IncludeSymbols>false</IncludeSymbols>
        <NoWarn>$(NoWarn);NU5128</NoWarn>
    </PropertyGroup>

    <ItemGroup>
        <None Include="$(OutputPath)$(AssemblyName).dll" Pack="true" PackagePath="analyzers/dotnet/cs" Visible="false" />
    </ItemGroup>

    <ItemGroup>
        <PackageReference Include="Microsoft.CodeAnalysis.CSharp" PrivateAssets="all" />
        <PackageReference Include="Microsoft.CodeAnalysis.Analyzers" PrivateAssets="all" />
    </ItemGroup>

    <!-- RS2008 release tracking: every CMTK id and severity is a reviewable diff in these tables. -->
    <ItemGroup>
        <AdditionalFiles Include="AnalyzerReleases.Shipped.md" />
        <AdditionalFiles Include="AnalyzerReleases.Unshipped.md" />
    </ItemGroup>

</Project>
