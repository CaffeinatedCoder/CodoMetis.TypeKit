<Project Sdk="Microsoft.NET.Sdk">

    <!--
      The base package: Option, Result and the value-object contracts. It must never reference
      Metalama, directly or transitively; MetalamaBoundaryTests fails the build if it does.
    -->
    <PropertyGroup>
        <Description>Option and Result types that cannot be misused, and the contracts for value objects and closed sets (smart enums): one validation rule and one typed fault, carried through JSON, EF Core, OpenAPI and HTTP problem details by the TypeKit packages. Also a merge patch's field and the text guards.</Description>
        <PackageTags>option;result;maybe;railway-oriented-programming;functional;error-handling;value-object;strongly-typed-id;primitive-obsession;ddd;domain-driven-design;native-aot</PackageTags>
    </PropertyGroup>

    <!--
      Native AOT and trimming: the analyzers run on every build, and warnings are errors, so a call
      that trimming or AOT cannot honour fails here rather than in a consumer's publish. The code the
      generators weave into a consumer is checked where it runs: the consumer smoke test publishes
      it with Native AOT. AotCompatibilityTests reads the packed assembly to hold this in place.
    -->
    <PropertyGroup>
        <IsAotCompatible>true</IsAotCompatible>
    </PropertyGroup>

    <!--
      The analyzers reach every consumer through this package: whoever can see the interfaces gets
      the guard (design/analyzers.md). It must stay an ordinary project reference: with
      ReferenceOutputAssembly="false", NuGet emits no dependency at all (measured 2026-09-27).
      Private="false" keeps the analyzer assembly out of this project's output, and nothing here
      compiles against it. PrivateAssets="none" keeps exclude="Build,Analyzers" off the dependency.
      OutputItemType="Analyzer" also runs the analyzers on this project's own code, as
      src/Directory.Build.targets does for the other packages.
      AnalyzerPackagingTests packs the packages and reads the nuspec to hold all of it in place.
    -->
    <ItemGroup>
        <ProjectReference Include="..\CodoMetis.TypeKit.Analyzers\CodoMetis.TypeKit.Analyzers.csproj" PrivateAssets="none" Private="false" OutputItemType="Analyzer" />
    </ItemGroup>

</Project>
