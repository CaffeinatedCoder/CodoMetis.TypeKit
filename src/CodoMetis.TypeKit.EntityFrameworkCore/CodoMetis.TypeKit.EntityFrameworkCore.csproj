<Project Sdk="Microsoft.NET.Sdk">

    <!-- Works at run time against the CodoMetis.TypeKit interfaces; never references .Generators. -->
    <PropertyGroup>
        <Description>EF Core integration for CodoMetis.TypeKit: value-object converters by convention, and `.Value` in LINQ queries.</Description>
        <PackageTags>efcore;entity-framework-core;value-object;strongly-typed-id;value-converter;linq;postgresql;ddd;native-aot</PackageTags>
    </PropertyGroup>

    <!--
      Native AOT and trimming analyzers on, as in every runtime package. This package's own code is
      clean; EF Core itself is not AOT-compatible (its DbContext constructors require dynamic code)
      and supports Native AOT only experimentally, through a compiled model and precompiled queries.
    -->
    <PropertyGroup>
        <IsAotCompatible>true</IsAotCompatible>
    </PropertyGroup>

    <ItemGroup>
        <PackageReference Include="Microsoft.EntityFrameworkCore.Relational" />
        <ProjectReference Include="..\CodoMetis.TypeKit\CodoMetis.TypeKit.csproj" />
    </ItemGroup>

</Project>
