<Project Sdk="Microsoft.NET.Sdk">

    <!-- Works at run time against the CodoMetis.TypeKit interfaces; never references .Generators. -->
    <PropertyGroup>
        <Description>ASP.NET Core integration for CodoMetis.TypeKit: OpenAPI schemas for value objects.</Description>
        <PackageTags>aspnetcore;openapi;json-schema;minimal-api;value-object;strongly-typed-id;ddd;native-aot</PackageTags>
    </PropertyGroup>

    <!-- Native AOT and trimming analyzers on, as in every runtime package. -->
    <PropertyGroup>
        <IsAotCompatible>true</IsAotCompatible>
    </PropertyGroup>

    <ItemGroup>
        <FrameworkReference Include="Microsoft.AspNetCore.App" />
        <PackageReference Include="Microsoft.AspNetCore.OpenApi" />
        <ProjectReference Include="..\CodoMetis.TypeKit\CodoMetis.TypeKit.csproj" />
    </ItemGroup>

    <ItemGroup>
        <InternalsVisibleTo Include="CodoMetis.TypeKit.AspNetCore.Tests" />
    </ItemGroup>

</Project>
