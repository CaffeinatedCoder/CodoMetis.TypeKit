<Project Sdk="Microsoft.NET.Sdk">

    <!--
      The only package that brings Metalama into a consumer's build. Its transitive project fabric
      (phase 3) applies the aspects in every project that references it, directly or not, so the
      Metalama.Framework reference flows on purpose (spikes/FabricSpike).
    -->
    <PropertyGroup>
        <Description>Compile-time generation of value objects and closed sets (smart enums) for CodoMetis.TypeKit, built on Metalama: one declared Create is what JSON, parsing, route binding and TryFrom apply.</Description>
        <PackageTags>value-object;strongly-typed-id;primitive-obsession;code-generation;metalama;ddd;domain-driven-design;system-text-json;iparsable;validation</PackageTags>
    </PropertyGroup>

    <ItemGroup>
        <PackageReference Include="Metalama.Framework" />
        <ProjectReference Include="..\CodoMetis.TypeKit\CodoMetis.TypeKit.csproj" />
    </ItemGroup>

</Project>
