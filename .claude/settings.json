{
  "$schema": "https://json.schemastore.org/claude-code-settings.json",
  "hooks": {
    "SessionStart": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "dotnet build \"$CLAUDE_PROJECT_DIR/tools/BashGuard/BashGuard.csproj\" -c Release -nologo -v q -tl:off -clp:NoSummary",
            "timeout": 180
          },
          {
            "type": "command",
            "command": "dotnet build \"$CLAUDE_PROJECT_DIR/tools/BuildVerdict/BuildVerdict.csproj\" -c Release -nologo -v q -tl:off -clp:NoSummary",
            "timeout": 180
          }
        ]
      }
    ],
    "PreToolUse": [
      {
        "matcher": "Bash",
        "hooks": [
          {
            "type": "command",
            "command": "dotnet \"$CLAUDE_PROJECT_DIR/tools/BashGuard/bin/Release/net10.0/bash-guard.dll\"",
            "timeout": 10
          }
        ]
      }
    ]
  }
}
