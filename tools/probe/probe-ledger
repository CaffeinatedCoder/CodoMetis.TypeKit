def cmd_lock(args):
    import socket
    now = time.time()
    record = {"holder": args.holder, "mode": args.mode, "owner": {"pid": args.pid or os.getppid(), "host": socket.gethostname()},
              "since": now, "heartbeat": now, "pending_replay": False}
    with LockMutex():
        held = read_json(lock_path(), None)
        if held and held.get("holder") != args.holder and lock_alive(held):
            print(f"probe-ledger: locked by {held['holder']} ({held['mode']}) since "
                  f"{time.strftime('%H:%M', time.localtime(held['since']))}", file=sys.stderr)
            sys.exit(1)
        if held:
            # A holder taking it again, or a holder whose heartbeat stopped: replace it atomically.
            record["pending_replay"] = bool(held.get("pending_replay"))
            write_json(lock_path(), record)
        else:
            # No lock: an exclusive create, so even a writer that bypasses the mutex cannot overwrite one.
            fd = os.open(lock_path(), os.O_CREAT | os.O_EXCL | os.O_WRONLY)
            with os.fdopen(fd, "w") as f:
                json.dump(record, f)
    taken_over = held if held and held.get("holder") != args.holder else None
    print(f"locked for {args.mode} by {args.holder}" + (f" (took over from {taken_over['holder']}, whose heartbeat stopped)" if taken_over else ""))


def heartbeat(holder=None):
    """Commands run under a round (PROBE_HOLDER set) keep its lock alive; so does `heartbeat --holder H`."""
    holder = holder or os.environ.get("PROBE_HOLDER")
    if not holder or not os.path.exists(lock_path()):
        return
    with LockMutex():
        held = read_json(lock_path(), None)
        if held and held.get("holder") == holder:
            held["heartbeat"] = time.time()
            write_json(lock_path(), held)


def owe_replay():
    """A replay that found the lock taken: noted on the lock, so its holder's unlock says so."""
    with LockMutex():
        held = read_json(lock_path(), None)
        if held:
            held["pending_replay"] = True
            write_json(lock_path(), held)


def cmd_heartbeat(args):
    heartbeat(args.holder)


def cmd_owe_replay(args):
    owe_replay()


def cmd_unlock(args):
    with LockMutex():
        held = read_json(lock_path(), None)
        if held and held.get("holder") != args.holder:
            sys.exit(f"probe-ledger: the lock is {held['holder']}'s, not {args.holder}'s")
        if held:
            os.remove(lock_path())
    if held and held.get("pending_replay"):
        print("unlocked; a replay was skipped while locked: run tools/probe/probe-replay now")
    else:
        print("unlocked")


def cmd_round_start(args):
    d, _ = branch_dir(args.branch)
    held = lock_holder()
    if not held or held.get("holder") != args.holder:
        sys.exit("probe-ledger: take the lock first; round-start records the caps of the lock's holder")
    write_json(os.path.join(d, "round.json"), {"holder": args.holder, "started": time.time(),
                                               "deadline": time.time() + args.minutes * 60,
                                               "max_claims": args.claims, "claims": []})
    print(f"round capped at {args.minutes} min" + (f" and {args.claims} claim(s)" if args.claims else ""))


def cmd_round_end(args):
    d, _ = branch_dir(args.branch)
    path = os.path.join(d, "round.json")
    rnd = read_json(path, None)
    if rnd and rnd.get("holder") == args.holder:
        os.remove(path)
        print(f"round ended: claims {', '.join(rnd['claims']) or 'none'}")


def cmd_abandon(args):
    """After a round was stopped from outside: repair the ledger files, clear the round's caps and
    release the lock, whoever holds it. What the round recorded stays; nothing else is touched."""
    d, _ = branch_dir(args.branch)
    cmd_repair(args)
    rnd = read_json(os.path.join(d, "round.json"), None)
    if rnd:
        os.remove(os.path.join(d, "round.json"))
        print(f"round caps cleared ({rnd.get('holder')}): claims {', '.join(rnd.get('claims', [])) or 'none'}")
    with LockMutex():
        held = read_json(lock_path(), None)
        if held:
            os.remove(lock_path())
    if held:
        print(f"lock of {held['holder']} ({held['mode']}) released"
              + ("; a replay was skipped while locked: run tools/probe/probe-replay now" if held.get("pending_replay") else ""))
    else:
        print("no lock was held")


def cmd_repair(args):
    d, _ = branch_dir(args.branch)
    fixed = 0
    for dirpath, _, files in os.walk(d):
        for name in files:
            if not name.endswith(".jsonl"):
                continue
            path = os.path.join(dirpath, name)
            data = open(path).read()
            if data and not data.endswith("\n"):
                with open(path, "w") as f:
                    f.write(data[: data.rfind("\n") + 1])
                fixed += 1
                print(f"  removed a partial last line from {os.path.relpath(path, d)}")
    print(f"repair: {fixed} file(s) fixed")


def compute_status(d, branch):
    universe = read_json(os.path.join(d, "universe.json"), None)
    if universe is None:
        return {"branch": branch, "done": False, "reason": "no universe.json: run `universe` (no round has run here)"}
    done = covered(d, universe)
    total = current_count = 0
    per_claim = {}
    for claim in universe["claims"]:
        pairs = pairs_of(claim)
        hit = sum((claim["id"], p) in done for p in pairs)
        per_claim[claim["id"]] = {"pairs": len(pairs), "current": hit}
        total += len(pairs)
        current_count += hit
    open_findings = sorted(i for i, f in effective_findings(d).items() if f["status"] == "open")
    return {
        "branch": branch, "head": git("rev-parse", "HEAD").stdout.strip(), "universe_commit": universe.get("commit"),
        "pairs": total, "current": current_count, "share": round(current_count / total, 4) if total else 1.0,
        "open_findings": open_findings, "claims": per_claim,
        "done": total > 0 and current_count == total and not open_findings,
    }


def cmd_status(args):
    d, branch = branch_dir(args.branch)
    s = compute_status(d, branch)
    if args.json:
        json.dump(s, sys.stdout, indent=1)
        print()
        return
    if "reason" in s:
        print(f"{branch}: not done ({s['reason']})")
        return
    print(f"{branch} at {s['head'][:7]}: {s['current']} of {s['pairs']} pairs current ({s['share']:.1%}), "
          f"{len(s['open_findings'])} open finding(s){': ' + ', '.join(s['open_findings']) if s['open_findings'] else ''}"
          f" -> {'DONE' if s['done'] else 'not done'}")
    for cid, c in sorted(s["claims"].items()):
        print(f"  {cid}: {c['current']}/{c['pairs']}")


def cmd_gate(args):
    """Release gate: nothing staged, no open finding, every probe passed at its current footprint, and
    full pairwise coverage for the claims whose footprint changed since the last release."""
    d, branch = branch_dir(args.branch)
    since = args.since or git("describe", "--tags", "--abbrev=0").stdout.strip()
    universe = build_universe(d, since, quiet=True)
    fp = Footprints(d)
    reasons = []
    staging = os.path.join(d, "staging")
    if os.path.isdir(staging) and any(files for _, _, files in os.walk(staging)):
        reasons.append("the staging corpus is not published (run `publish` and commit tools/probe/corpus)")
    open_findings = sorted(i for i, f in effective_findings(d).items() if f["status"] == "open")
    if open_findings:
        reasons.append(f"open findings: {', '.join(open_findings)}")
    runs = latest(read_jsonl(os.path.join(d, "runs.jsonl")), "probe")
    for s in probe_states(d, True):
        if s["stale"]:
            reasons.append(f"{s['probe']}: not replayed at its current footprint (run probe-replay --all)")
        elif runs.get(s["probe"], {}).get("result") != "pass":
            reasons.append(f"{s['probe']}: its last replay failed")
        else:
            ev = read_json(evidence_path(d, s["probe"]), {})
            exp = set().union(*[set(v.get("expected", [])) for v in ev.get("variants", [])] or [set()])
            exe = set().union(*[set(v.get("executed", [])) for v in ev.get("variants", [])] or [set()])
            if exp - exe:
                reasons.append(f"{s['probe']}: {len(exp - exe)} expected row(s) did not run")
    done = covered(d, universe)
    by_claim = {}
    for probe, r in registry(d).items():
        by_claim.setdefault(r.get("claim"), []).append(probe)
    changed = git("diff", "--name-only", since, "HEAD").stdout.split()
    def under(paths):
        return any(f == w or f.startswith(w.rstrip("/") + "/") for f in changed for w in paths)
    # Conservative selection: a claim is touched when its source document, its surfaces' source areas or the
    # build inputs changed since the release; footprints only add to that, never subtract.
    build_inputs = ["Directory.Packages.props", "Directory.Build.props", "global.json"]
    # A reviewed waiver (tracked in the corpus) meets an obligation without a probe, so the gate never needs
    # a model: every obligation is met by a hand-written or generated probe, or by a waiver someone signed.
    waivers = {w["claim"]: w for w in read_json(corpus_path(d, "waivers.json"), [])
               if w.get("claim") and w.get("reason") and w.get("reviewed_by")}
    waived = []
    required, missing_total, by_footprint_only, missed_by_footprint = [], 0, [], []
    for claim in universe["claims"]:
        source = claim["source"].split("#", 1)[0]
        conservative = under([source]) or under(claim.get("watched", [])) or under(build_inputs)
        probes = by_claim.get(claim["id"], [])
        footprint = any(fp.changed_between(p, since) for p in probes) if probes else False
        if probes and conservative and not footprint:
            missed_by_footprint.append(claim["id"])
        if footprint and not conservative:
            by_footprint_only.append(claim["id"])
        if (conservative or footprint) and claim["id"] in waivers:
            waived.append(claim["id"])
            continue
        if conservative or footprint:
            pairs = pairs_of(claim)
            missing = sum((claim["id"], p) not in done for p in pairs)
            required.append(claim["id"])
            missing_total += missing
            if missing:
                reasons.append(f"{claim['id']}: {missing} of {len(pairs)} pairs uncovered (touched since {since})")
    if args.json:
        json.dump({"since": since, "touched": required, "uncovered_pairs": missing_total, "reasons": reasons,
                   "selected_by_footprint_only": by_footprint_only, "waived": waived,
                   "missed_by_footprint_alone": missed_by_footprint, "passes": not reasons}, sys.stdout, indent=1)
        print()
        sys.exit(1 if reasons else 0)
    if reasons:
        print(f"probe gate: refused for {branch} since {since} ({len(required)} claim(s) touched, "
              f"{missing_total} pair(s) uncovered):", file=sys.stderr)
        for r in reasons:
            print(f"  {r}", file=sys.stderr)
        sys.exit(1)
    print(f"probe gate: {branch} passes since {since}: {len(required)} claim(s) touched and fully covered"
          + (f", {len(waived)} waived ({', '.join(waived)})" if waived else "")
          + ", every probe replayed and passing, no open finding.")


