#!/usr/bin/env python3
"""Coverage bookkeeping for the prober agent, so no count is left to a model's judgement.

Tracked in the repository, under tools/probe/corpus/ (the corpus: what anyone needs to replay the
probes and reproduce the release gate):
  claims.json      the claims the documents make, each naming its surfaces
  registry.json    {"probes": {name: {"claim", "filter", "variants", "retired"}}}
  harness/, probes/ the probe sources, copied into the consumer test project to run
  rows/<claim>.json the rows each claim's probe runs: a pairwise covering array over the claim's axes
  dismissed.jsonl  findings the maintainers dismissed, with the reason
  waivers.json     [{"claim", "reason", "reviewed_by", "date"}]: a claim's gate obligation met without a probe

Local, under <main checkout>/.claude/agent-memory-local/prober/ (machine and branch state, rebuilt
or re-measured on demand; also from a linked worktree, so every worktree shares one):
  branches/<branch>/staging/   corpus files a round wrote and nobody published yet (same layout;
                               it overlays the tracked corpus until `publish` moves it there)
  branches/<branch>/universe.json  each claim's axes and pairs, built by `universe`
  branches/<branch>/footprints.jsonl  per probe: the src files a run executed, the compile-time paths,
                               the toolchain, each with its id when measured
  branches/<branch>/runs.jsonl replay results; ledger.jsonl pairs a round recorded (a cache);
                               findings.jsonl open/fixed findings; round.json the running round's caps
  axes-generated.json, round.lock

A pair is covered when a registered probe whose rows include it passed its last replay at a footprint
that is still current, or when a round recorded it in the ledger at a still-current footprint.
A `fixed` finding counts only once its commit is in HEAD's history.

Commands (run anywhere inside the repository):
  universe [--base REF]                 build universe.json; report settings no surface reaches or that have no values
  rows --claim C [--full] [--max N]     a covering array over the claim's pairs not yet covered (--full: all of them).
                                        Inside a capped round it refuses after the deadline or past the claim cap.
  status [--json]                       coverage, open findings, done or not
  gate [--since REF]                    release gate; REF defaults to the last tag
  footprint --probe P --cobertura F... --root WT [--include src] [--compile-time PATH...]
  register --probe P --claim C --filter F [--variants JSON]   a new probe, in the staging registry
  publish                               move the staging corpus into tools/probe/corpus/ (then commit it)
  stale [--json] [--include-retired]    probes whose footprint changed: the replay list
  record-run --probe P --result pass|fail [--seconds S]   a fail of a probe that passed before opens R-<probe>-<sha>
  mark retired --probe P                replayed only with --include-retired (release)
  dismiss --id F --reason TEXT          a finding the maintainers dismissed, kept in the corpus
  lock --holder H --mode M [--pid P] / unlock --holder H   one round at a time: an exclusive create, the owner
                                        and a heartbeat inside; a holder is alive while its heartbeat is under
                                        20 minutes old (heartbeat --holder H, or any command with PROBE_HOLDER=H)
  round-start --holder H --minutes M [--claims N] / round-end --holder H   the caps `rows` enforces
  repair                                drop a partial last line a killed round left in a .jsonl file
  abandon                               after a round was stopped from outside: repair, clear its caps, release the lock
Every command takes --branch B (default: the checked-out branch).
"""
import argparse, datetime, itertools, json, os, random, subprocess, sys, time


def git(*args):
    return subprocess.run(["git", *args], capture_output=True, text=True)


def root():
    """The main checkout, also from a linked worktree, so every worktree shares one ledger."""
    out = git("rev-parse", "--path-format=absolute", "--git-common-dir")
    if out.returncode != 0:
        sys.exit("probe-ledger: not inside a git repository")
    return os.path.dirname(out.stdout.strip())


def toplevel():
    return git("rev-parse", "--show-toplevel").stdout.strip()


def memory_dir():
    """Where machine state goes: PROBE_STATE_DIR when set (CI points it into its own workspace, so nothing
    is read from a developer's local memory), else the main checkout's prober memory."""
    return os.environ.get("PROBE_STATE_DIR") or os.path.join(root(), ".claude", "agent-memory-local", "prober")


def corpus_dir():
    return os.path.join(toplevel(), "tools", "probe", "corpus")


def branch_dir(branch):
    if branch is None:
        branch = git("rev-parse", "--abbrev-ref", "HEAD").stdout.strip()
    return os.path.join(memory_dir(), "branches", branch.replace("/", "-")), branch


def read_json(path, default):
    if not os.path.exists(path):
        return default
    with open(path) as f:
        try:
            return json.load(f)
        except ValueError:
            return default   # a file another process is creating this instant: treated as not there yet


def write_json(path, value):
    os.makedirs(os.path.dirname(path), exist_ok=True)
    tmp = f"{path}.{os.getpid()}.tmp"
    with open(tmp, "w") as f:
        json.dump(value, f, indent=1)
        f.write("\n")
    os.replace(tmp, path)


def read_jsonl(path):
    """Every complete line; a partial last line (a killed writer) is skipped, never fatal."""
    if not os.path.exists(path):
        return []
    out = []
    with open(path) as f:
        for line in f:
            if line.strip():
                try:
                    out.append(json.loads(line))
                except ValueError:
                    pass
    return out


def append_jsonl(path, value):
    """Appends one line by writing the whole file anew to a temp file and renaming it over the old one,
    so a reader sees the file before or after the line, never half of it, on every OS."""
    os.makedirs(os.path.dirname(path), exist_ok=True)
    old = open(path).read() if os.path.exists(path) else ""
    if old and not old.endswith("\n"):
        old = old[: old.rfind("\n") + 1]
    tmp = f"{path}.{os.getpid()}.tmp"
    with open(tmp, "w") as f:
        f.write(old + json.dumps(value) + "\n")
    os.replace(tmp, path)


def axes_block(path):
    """The fenced ```json probe-axes block of the axes file: hand, ignored, refused, axes, surfaces, replay."""
    text = open(path).read()
    marker = "```json probe-axes"
    if marker not in text:
        sys.exit(f"probe-ledger: {path} has no {marker} block")
    return json.loads(text.split(marker, 1)[1].split("```", 1)[0])


def axes_file():
    return os.path.join(toplevel(), ".claude", "probe-axes.md")


# --- the corpus: tracked, overlaid by the branch's staging -------------------------------------------

def corpus_path(d, rel):
    """A corpus file: the staging copy when a round wrote one, else the tracked one."""
    staged = os.path.join(d, "staging", rel)
    return staged if os.path.exists(staged) else os.path.join(corpus_dir(), rel)


def registry(d):
    tracked = read_json(os.path.join(corpus_dir(), "registry.json"), {"probes": {}})["probes"]
    staged = read_json(os.path.join(d, "staging", "registry.json"), {"probes": {}})["probes"]
    return {**tracked, **staged}


def claims(d):
    tracked = read_json(os.path.join(corpus_dir(), "claims.json"), [])
    staged = read_json(os.path.join(d, "staging", "claims.json"), [])
    merged = {c["id"]: c for c in tracked}
    merged.update({c["id"]: c for c in staged})
    return list(merged.values())


def read_rows(path):
    """A rows file, plain (staging) or gzipped (the corpus: machine data, kept small in git)."""
    import gzip
    if os.path.exists(path):
        return json.load(open(path)).get("rows", [])
    if os.path.exists(path + ".gz"):
        with gzip.open(path + ".gz", "rt") as f:
            return json.load(f).get("rows", [])
    return []


def rows_of(d, claim_id):
    rel = os.path.join("rows", f"{claim_id}.json")
    staged = os.path.join(d, "staging", rel)
    return read_rows(staged) if os.path.exists(staged) else read_rows(os.path.join(corpus_dir(), rel))


def identity(d, probe):
    """What a result of `probe` depends on besides the product footprint: its registry entry, every source
    compiled with it (the harness and all probes), its claim's rows, the axes file, and the build
    environment (SDK, central package versions, build props, global.json). A result counts only while
    this is unchanged; a change to any of them voids it."""
    import gzip, hashlib
    h = hashlib.sha256()
    entry = registry(d).get(probe, {})
    h.update(json.dumps(entry, sort_keys=True).encode())
    sources = {}
    for base in (corpus_dir(), os.path.join(d, "staging")):
        for sub in ("harness", "probes"):
            folder = os.path.join(base, sub)
            if os.path.isdir(folder):
                for name in os.listdir(folder):
                    if name.endswith(".cs"):
                        sources[name] = os.path.join(folder, name)
    for name in sorted(sources):
        h.update(name.encode() + b"\0" + open(sources[name], "rb").read())
    h.update(json.dumps(rows_of(d, entry.get("claim", "")), sort_keys=True).encode())
    try:
        h.update(json.dumps(axes_block(axes_file()), sort_keys=True).encode())
    except (SystemExit, OSError):
        h.update(b"no axes file")
    for path in ("Directory.Packages.props", "Directory.Build.props", "global.json"):
        h.update(path.encode() + (head_hash(path) or "-").encode())
    h.update(json.dumps(toolchain_now(), sort_keys=True).encode())
    return h.hexdigest()[:16]


def pairs_of(claim):
    axes = claim["axes"]
    excluded = {frozenset(p) for p in claim.get("exclude", [])}
    result = set()
    for a, b in itertools.combinations(sorted(axes), 2):
        for va in axes[a]:
            for vb in axes[b]:
                pair = frozenset((f"{a}={va}", f"{b}={vb}"))
                if pair not in excluded:
                    result.add(pair)
    return result


def pairs_of_row(claim, row):
    """The pairs one row sets, restricted to the claim's current axes and values."""
    axes = claim["axes"]
    items = sorted((k, v) for k, v in row.items() if k in axes and v in axes[k])
    return {frozenset((f"{a}={va}", f"{b}={vb}")) for (a, va), (b, vb) in itertools.combinations(items, 2)}


# --- footprints ---------------------------------------------------------------------------------------

def head_hash(path, rev="HEAD"):
    """The object id of a file (blob) or a directory (tree) at rev, or None when it does not exist there."""
    out = git("rev-parse", "-q", "--verify", f"{rev}:{path}")
    return out.stdout.strip() if out.returncode == 0 else None


def toolchain_now():
    """What no file in the repository records: the SDK a global.json roll-forward picked, say."""
    try:
        cfg = axes_block(axes_file()).get("replay", {})
    except (SystemExit, OSError):
        return {}
    out = {}
    for name, argv in cfg.get("toolchain", {}).items():
        r = subprocess.run(argv, capture_output=True, text=True, cwd=toplevel())
        text = (r.stdout.strip() or r.stderr.strip())
        out[name] = text.splitlines()[0] if text else ""
    return out


def latest(lines, key):
    last = {}
    for line in lines:
        last[line[key]] = line
    return last


class Footprints:
    """Each probe's footprint: the src files its run executed (from coverage) plus the compile-time
    paths every probe depends on and the toolchain, each with its id when measured. A probe is current
    when every one of them is unchanged at HEAD, so a commit stales only the probes whose footprint it
    touched."""

    def __init__(self, d):
        self.records = latest(read_jsonl(os.path.join(d, "footprints.jsonl")), "probe")
        self.cache = {}
        self._toolchain = None

    def measured(self, probe):
        return bool(self.records.get(probe, {}).get("footprint"))

    def current(self, probe):
        if probe not in self.cache:
            r = self.records.get(probe)
            if not r or not r.get("footprint"):
                self.cache[probe] = False
            else:
                if self._toolchain is None:
                    self._toolchain = toolchain_now()
                paths = {**r["footprint"], **r.get("compileTime", {})}
                self.cache[probe] = (all(head_hash(p) == h for p, h in paths.items())
                                     and all(self._toolchain.get(k) == v for k, v in r.get("toolchain", {}).items()))
        return self.cache[probe]

    def changed_between(self, probe, base):
        r = self.records.get(probe) or {}
        paths = list(r.get("footprint", {})) + list(r.get("compileTime", {}))
        if not paths:
            return True
        return git("diff", "--quiet", base, "HEAD", "--", *paths).returncode != 0


class Currency:
    """For a ledger line with no measured footprint: none of the claim's watched paths changed since."""

    def __init__(self, watched):
        self.watched = watched or ["."]
        self.cache = {}

    def __call__(self, commit):
        if commit not in self.cache:
            self.cache[commit] = git("diff", "--quiet", commit, "HEAD", "--", *self.watched).returncode == 0
        return self.cache[commit]


def evidence_path(d, probe):
    return os.path.join(d, "evidence", f"{probe}.json")


def credited_rows(d, probe, claim, ev, ident=None, fp=None):
    """The rows of one probe's evidence that earn credit, as (index, applied settings): only while its
    identity and product footprint are current, and only rows that were expected, executed, and ended
    as a pass. Credit goes to the settings that applied, never to the ones requested."""
    if ev is None or ev.get("identity") != (ident or identity(d, probe)):
        return []
    if fp is not None and not fp.current(probe):
        return []
    expected, executed = set(), set()
    for v in ev.get("variants", []):
        expected |= {int(i) for i in v.get("expected", [])}
        executed |= {int(i) for i in v.get("executed", [])}
    out = []
    for idx, row in ev.get("rows", {}).items():
        i = int(idx)
        if i in expected and i in executed and row.get("category") == "pass" and row.get("applied"):
            out.append((i, row["applied"]))
    return out


def covered(d, universe, claim_id=None):
    """(claim, pair) -> "pass" for every pair some current evidence earned (see credited_rows). The
    ledger of a round's own records earns nothing: only replayed, identity-bound evidence counts."""
    fp = Footprints(d)
    by_id = {c["id"]: c for c in universe["claims"]}
    done = {}
    for name, entry in registry(d).items():
        cid = entry.get("claim")
        if (claim_id and cid != claim_id) or cid not in by_id:
            continue
        ev = read_json(evidence_path(d, name), None)
        for _, applied in credited_rows(d, name, by_id[cid], ev, fp=fp):
            for pair in pairs_of_row(by_id[cid], applied):
                done[(cid, pair)] = "pass"
    return done


def effective_findings(d):
    """The last line per finding id; a `fixed` line counts only once its commit is in HEAD's history,
    and a finding dismissed in the corpus is closed on every branch that carries the dismissal."""
    last = {}
    for f in read_jsonl(os.path.join(d, "findings.jsonl")):
        if f.get("status") == "fixed" and f.get("commit"):
            if git("merge-base", "--is-ancestor", f["commit"], "HEAD").returncode != 0:
                continue
        last[f["id"]] = f
    for f in read_jsonl(corpus_path(d, "dismissed.jsonl")):
        last[f["id"]] = {**f, "status": "dismissed"}
    return last


# --- the round's caps ---------------------------------------------------------------------------------

HEARTBEAT_MINUTES = 20   # a process holder beats every HEARTBEAT_SECONDS; an agent with each ledger call
HEARTBEAT_SECONDS = 30


def lock_path():
    return os.path.join(memory_dir(), "round.lock")


class LockMutex:
    """Serializes every read-judge-write of the lock with an exclusive directory create, which is atomic
    on every OS (no flock, no signals), so two takers can never both see the lock free or both take over
    a dead holder. A mutex directory older than MUTEX_STALE_SECONDS is a crashed writer's and is removed."""

    MUTEX_STALE_SECONDS = 60

    def __enter__(self):
        self.path = lock_path() + ".mutex"
        os.makedirs(memory_dir(), exist_ok=True)
        deadline = time.time() + 10
        while True:
            try:
                os.mkdir(self.path)
                return self
            except FileExistsError:
                try:
                    if time.time() - os.stat(self.path).st_mtime > self.MUTEX_STALE_SECONDS:
                        os.rmdir(self.path)
                        continue
                except OSError:
                    continue
                if time.time() > deadline:
                    sys.exit("probe-ledger: the lock's mutex is held for over 10 s; another command is stuck")
                time.sleep(0.02)

    def __exit__(self, *exc):
        try:
            os.rmdir(self.path)
        except OSError:
            pass


def lock_alive(held):
    """A holder is alive while its heartbeat is younger than HEARTBEAT_MINUTES. Liveness is the heartbeat
    alone: long-running holders (probe-replay, probe-round) refresh it from a thread, an agent through the
    commands it runs with PROBE_HOLDER set. No process is probed, which is portable and never signals one."""
    return time.time() - held.get("heartbeat", held.get("since", 0)) < HEARTBEAT_MINUTES * 60


def lock_holder():
    """The running round's lock, or None when there is none or its holder is gone."""
    held = read_json(lock_path(), None)
    return held if held and lock_alive(held) else None


def active_round(d):
    """The caps of the round that holds the lock, if one does."""
    rnd = read_json(os.path.join(d, "round.json"), None)
    held = lock_holder()
    if rnd and held and held.get("holder") == rnd.get("holder"):
        return rnd
    return None


# --- commands -----------------------------------------------------------------------------------------

def cmd_rows(args):
    d, _ = branch_dir(args.branch)
    universe = read_json(os.path.join(d, "universe.json"), None)
    if universe is None:
        sys.exit("probe-ledger: no universe.json for this branch yet; run `universe` first")
    claim = next((c for c in universe["claims"] if c["id"] == args.claim), None)
    if claim is None:
        sys.exit(f"probe-ledger: no claim {args.claim} in the universe")
    rnd = active_round(d)
    if rnd and not args.full:
        if time.time() > rnd["deadline"]:
            sys.exit("probe-ledger: the round's time is spent; start no new work. Record what ran, hand the "
                     "corpus off, and report.")
        if args.claim not in rnd["claims"]:
            if rnd.get("max_claims") and len(rnd["claims"]) >= rnd["max_claims"]:
                sys.exit(f"probe-ledger: the round's cap of {rnd['max_claims']} claim(s) is reached "
                         f"({', '.join(rnd['claims'])}); finish those and report.")
            rnd["claims"].append(args.claim)
            write_json(os.path.join(d, "round.json"), rnd)
    done = {} if args.full else covered(d, universe, claim["id"])
    todo = {p for p in pairs_of(claim) if (claim["id"], p) not in done}
    excluded = {frozenset(p) for p in claim.get("exclude", [])}
    axes = claim["axes"]
    names = sorted(axes)
    rng = random.Random(args.seed)
    rows = []
    # Greedy covering array: each row is the best of a few randomized greedy candidates.
    while todo and len(rows) < args.max:
        best, best_gain = None, -1
        for _ in range(30):
            order = names[:]
            rng.shuffle(order)
            row = {}
            for name in order:
                options = axes[name][:]
                rng.shuffle(options)
                def gain(v):
                    if any(frozenset((f"{name}={v}", f"{n}={w}")) in excluded for n, w in row.items()):
                        return -1
                    return sum(frozenset((f"{name}={v}", f"{n}={w}")) in todo for n, w in row.items())
                row[name] = max(options, key=gain)
            g = sum(frozenset((f"{a}={row[a]}", f"{b}={row[b]}")) in todo for a, b in itertools.combinations(names, 2))
            if g > best_gain:
                best, best_gain = row, g
        if best_gain <= 0:
            # Seed a row from one uncovered pair so progress never stalls.
            pair = sorted(next(iter(todo)))
            best = {name: axes[name][0] for name in names}
            for item in pair:
                k, v = item.split("=", 1)
                best[k] = v
        newly = {frozenset((f"{a}={best[a]}", f"{b}={best[b]}")) for a, b in itertools.combinations(names, 2)} & todo
        todo -= newly
        rows.append({"row": best, "pairs": [sorted(p) for p in newly]})
    json.dump({"claim": claim["id"], "rows": rows, "uncovered_after": len(todo)}, sys.stdout, indent=1)
    print()


def build_universe(d, base, axes_path=None, generated_path=None, claims_path=None, quiet=False):
    import fnmatch, re
    block = axes_block(axes_path or axes_file())
    generated = read_json(generated_path or os.path.join(memory_dir(), "axes-generated.json"), None)
    if generated is None:
        sys.exit("probe-ledger: no axes-generated.json; run `probe-replay --all`, which derives the axes")
    all_claims = read_json(claims_path, None) if claims_path else claims(d)
    if not all_claims:
        sys.exit("probe-ledger: no claims (tools/probe/corpus/claims.json, or the branch's staging)")
    ignored, hand = block.get("ignored", {}), block.get("hand", {})

    axes = {}
    for name, values in generated["axes"].items():
        if name not in ignored:
            axes[name] = values
    problems = []
    for name in generated.get("needsValues", []):
        if name in ignored:
            continue
        if name in hand:
            axes[name] = ["default", *hand[name]]
        else:
            problems.append(f"needs values: {name} (no hand values and not ignored)")
    for name, values in hand.items():
        if name not in axes and name not in ignored:
            axes[name] = ["default", *values]
    for name, values in block.get("axes", {}).items():
        axes[name] = values
    for name, refused in block.get("refused", {}).items():
        if name in axes:
            axes[name] = [v for v in axes[name] if v not in refused]

    surfaces = block["surfaces"]
    reached = set()
    for surface in surfaces.values():
        for pattern in surface["axes"]:
            reached |= set(fnmatch.filter(axes, pattern))
    for name in sorted(set(generated["axes"]) | set(generated.get("needsValues", []))):
        if name not in ignored and name in axes and name not in reached:
            problems.append(f"unassigned: {name} (no surface reaches it and it is not ignored)")

    out = []
    for claim in all_claims:
        source_file = claim["source"].split("#", 1)[0]
        mine, watched = {}, []
        for sname in claim["surfaces"]:
            if sname not in surfaces:
                sys.exit(f"probe-ledger: claim {claim['id']} names unknown surface {sname}")
            for pattern in surfaces[sname]["axes"]:
                for name in fnmatch.filter(axes, pattern):
                    mine[name] = axes[name]
            watched += surfaces[sname]["watched"]
        source_text = ""
        if os.path.exists(os.path.join(toplevel(), source_file)):
            source_text = re.sub(r"\s+", " ", open(os.path.join(toplevel(), source_file)).read())
        for name, quote in claim.get("narrow", {}).items():
            if re.sub(r"\s+", " ", quote) not in source_text:
                sys.exit(f"probe-ledger: claim {claim['id']} narrows {name} by a quote not found in {source_file}")
            mine.pop(name, None)
        mine.update(claim.get("axes", {}))
        entry = {"id": claim["id"], "source": claim["source"], "surfaces": claim["surfaces"],
                 "watched": sorted(set(watched + [source_file])), "axes": mine}
        if claim.get("exclude"):
            entry["exclude"] = claim["exclude"]
        out.append(entry)

    universe = {"base": git("merge-base", "HEAD", base).stdout.strip(), "commit": git("rev-parse", "HEAD").stdout.strip(),
                "generated_versions": generated.get("versions", {}), "claims": out}
    write_json(os.path.join(d, "universe.json"), universe)
    if not quiet:
        total = 0
        for entry in out:
            n = len(pairs_of(entry))
            total += n
            print(f"{entry['id']}: {len(entry['axes'])} axes, {n} pairs")
        print(f"universe: {len(out)} claims, {total} pairs")
        for problem in problems:
            print(f"  {problem}")
    return universe


def cmd_universe(args):
    d, _ = branch_dir(args.branch)
    build_universe(d, args.base, args.axes, args.generated, args.claims)


def cmd_footprint(args):
    """Record a probe's footprint from Cobertura reports of runs of that probe alone."""
    import xml.etree.ElementTree as ET
    d, _ = branch_dir(args.branch)
    wt = os.path.realpath(args.root)
    hit = set()
    for report in args.cobertura:
        tree = ET.parse(report)
        sources = [os.path.realpath(x.text) for x in tree.iter("source") if x.text]
        for cls in tree.iter("class"):
            if not any(int(l.get("hits", "0")) > 0 for l in cls.iter("line")):
                continue
            name = cls.get("filename", "")
            for c in ([name] if os.path.isabs(name) else [os.path.join(s, name) for s in sources] or [name]):
                c = os.path.realpath(c)
                if c.startswith(wt + os.sep):
                    rel = os.path.relpath(c, wt)
                    if any(rel == p or rel.startswith(p.rstrip("/") + "/") for p in args.include):
                        hit.add(rel)
                    break
    if not hit:
        sys.exit("probe-ledger: the coverage report shows no executed file under " + ", ".join(args.include) +
                 "; refusing to record an empty footprint (it would never go stale)")
    rev = git("-C", wt, "rev-parse", "HEAD").stdout.strip()
    def at(path):
        out = git("-C", wt, "rev-parse", "-q", "--verify", f"HEAD:{path}")
        return out.stdout.strip() if out.returncode == 0 else None
    footprint = {p: at(p) for p in sorted(hit)}
    compile_time = {p: at(p) for p in args.compile_time}
    append_jsonl(os.path.join(d, "footprints.jsonl"),
                 {"probe": args.probe, "commit": rev, "footprint": footprint, "compileTime": compile_time,
                  "toolchain": toolchain_now(), "date": args.date})
    print(f"{args.probe}: {len(footprint)} src files, {len(compile_time)} compile-time paths at {rev[:7]}")


def probe_states(d, include_retired):
    fp = Footprints(d)
    runs = read_jsonl(os.path.join(d, "runs.jsonl"))
    states = []
    for probe, r in sorted(registry(d).items()):
        passes = sum(1 for x in runs if x["probe"] == probe and x["result"] == "pass")
        retired = bool(r.get("retired"))
        ev = read_json(evidence_path(d, probe), None)
        stale = not fp.current(probe) or ev is None or ev.get("identity") != identity(d, probe)
        states.append({"probe": probe, "claim": r.get("claim"), "filter": r.get("filter"),
                       "variants": r.get("variants") or [{}], "stale": stale, "retired": retired,
                       "passes": passes, "replay": stale and (include_retired or not retired)})
    return states


def cmd_stale(args):
    d, _ = branch_dir(args.branch)
    states = probe_states(d, args.include_retired)
    if args.json:
        json.dump(states, sys.stdout, indent=1)
        print()
        return
    todo = [s for s in states if s["replay"]]
    print(f"{len(todo)} of {len(states)} probes to replay{' (retired included)' if args.include_retired else ''}")
    for s in todo:
        print(f"  {s['probe']}  {s['filter']}")


def cmd_register(args):
    d, _ = branch_dir(args.branch)
    path = os.path.join(d, "staging", "registry.json")
    staged = read_json(path, {"probes": {}})
    entry = {"claim": args.claim, "filter": args.filter}
    if args.variants:
        entry["variants"] = json.loads(args.variants)
    staged["probes"][args.probe] = {**registry(d).get(args.probe, {}), **entry}
    write_json(path, staged)
    print(f"registered {args.probe} (staged; `publish` moves it into the corpus)")


def cmd_publish(args):
    """Move the branch's staging into tools/probe/corpus/, merging registry.json and claims.json."""
    import shutil
    d, _ = branch_dir(args.branch)
    staging = os.path.join(d, "staging")
    if not os.path.isdir(staging):
        print("nothing staged")
        return
    corpus = corpus_dir()
    moved = []
    for dirpath, _, files in os.walk(staging):
        for name in files:
            src = os.path.join(dirpath, name)
            rel = os.path.relpath(src, staging)
            dst = os.path.join(corpus, rel)
            if rel == "registry.json":
                tracked = read_json(dst, {"probes": {}})
                tracked["probes"].update(read_json(src, {"probes": {}})["probes"])
                write_json(dst, tracked)
            elif rel == "claims.json":
                merged = {c["id"]: c for c in read_json(dst, [])}
                merged.update({c["id"]: c for c in read_json(src, [])})
                write_json(dst, sorted(merged.values(), key=lambda c: c["id"]))
            elif rel.startswith("rows" + os.sep) and rel.endswith(".json"):
                import gzip
                os.makedirs(os.path.dirname(dst), exist_ok=True)
                rows = [{"row": r.get("row", r)} for r in read_rows(src)]
                body = '{"claim": %s, "rows": [\n' % json.dumps(os.path.basename(rel)[:-5]) + \
                       ",\n".join(json.dumps(r, separators=(",", ":"), sort_keys=True) for r in rows) + "\n]}\n"
                with gzip.GzipFile(dst + ".gz", "wb", mtime=0) as out:
                    out.write(body.encode())
                rel += ".gz"
            elif rel.endswith(".jsonl"):
                os.makedirs(os.path.dirname(dst), exist_ok=True)
                with open(dst, "a") as out:
                    out.write(open(src).read())
            else:
                os.makedirs(os.path.dirname(dst), exist_ok=True)
                shutil.copy2(src, dst)
            moved.append(rel)
    shutil.rmtree(staging)
    print(f"published {len(moved)} file(s) into {os.path.relpath(corpus, toplevel())}:")
    for rel in sorted(moved):
        print(f"  {rel}")


def cmd_record_run(args):
    d, _ = branch_dir(args.branch)
    rev = git("rev-parse", "HEAD").stdout.strip()
    ident = identity(d, args.probe)
    runs_path = os.path.join(d, "runs.jsonl")
    # A regression is a probe that passed with this very identity (corpus, axes, environment) and fails
    # now; after any change to those, a failure is the probe's to triage, not the product's.
    passes = [x for x in read_jsonl(runs_path) if x["probe"] == args.probe and x["result"] == "pass"]
    passed_before = any(x.get("identity") == ident for x in passes)
    append_jsonl(runs_path, {"probe": args.probe, "result": args.result, "commit": rev, "date": args.date,
                             "seconds": args.seconds, "identity": ident})
    if args.evidence:
        ev = read_json(args.evidence, {})
        ev.update({"probe": args.probe, "identity": ident, "commit": rev, "result": args.result, "date": args.date})
        write_json(evidence_path(d, args.probe), ev)
    if args.result == "fail" and passes and not passed_before:
        print(f"{args.probe}: fails after a change to its corpus, axes or environment; triage the probe, not the product")
    if args.result == "fail" and passed_before:
        append_jsonl(os.path.join(d, "findings.jsonl"),
                     {"id": f"R-{args.probe}-{rev[:7]}", "claim": registry(d).get(args.probe, {}).get("claim"),
                      "status": "open", "commit": rev, "probe": args.probe,
                      "reason": "replay: a probe that passed with this identity fails at this commit"})


