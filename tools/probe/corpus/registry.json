    "C09BaseRecordEqualityProbe": {
      "claim": "C09-base-record-equality",
      "filter": "*C09BaseRecordEqualityProbe",
      "seeds": [
        {
          "obligation": "in-a-collection-of-the-base",
          "patch": "seeds/C09-base-record-equality-in-a-collection-of-the-base.patch",
          "defect": "The value object implements only its direct base's IEquatable<TBase> again, so a collection of a deeper base compares it by that base's own equality."
        },
        {
          "obligation": "equal-by-the-wrapped-value",
          "patch": "seeds/C09-base-record-equality-equal-by-the-wrapped-value.patch",
          "defect": "Over a base record, the generated Equals(TSelf) also calls the base's Equals(TBase), so a base comparing by reference makes two value objects over one value unequal."
        }
