        },
        {
          "PROBE_ONLY": "process.converter-lookup=wrapped-type-converter-looked-up-first"
        }
      ],
      "seeds": [
        {
          "obligation": "by-kind",
          "patch": "seeds/C07-by-kind.patch",
          "defect": "AddFaultResponses() answers a member of kind Conflict with 400, not the 409 its kind gives."
        },
        {
          "obligation": "own-mapping",
          "patch": "seeds/C07-own-mapping.patch",
          "defect": "AddFaultResponses(fault => ...) keeps only the status its mapping gives and drops the problem type."
