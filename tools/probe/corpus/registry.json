          "PROBE_ONLY": "process.converter-lookup=wrapped-type-converter-looked-up-first,text.culture!=globalization-invariant"
        },
        {
          "PROBE_ONLY": "text.culture=globalization-invariant",
          "DOTNET_SYSTEM_GLOBALIZATION_INVARIANT": "1"
        },
        {
          "PROBE_ONLY": "text.culture=globalization-invariant,entry=AsText"
