        {
          "obligation": "mapping-refusal-stops-start",
          "patch": "seeds/C07-mapping-refused.patch",
          "defect": "AddFaultResponses(fault => ...) answers a member its mapping throws for, or gives a status that is no error, with 500 instead of stopping the start."
