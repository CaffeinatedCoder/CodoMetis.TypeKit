        {
          "PROBE_ONLY": "process.converter-lookup=wrapped-type-converter-looked-up-first"
        }
      ],
      "seed": {
        "patch": "seeds/C07-fault-responses-blanket.patch",
        "defect": "A value object's OpenAPI schema drops the wrapped type's format (int32, uuid, date-time)."
      }
    },
    "C01DecimalSpellingProbe": {
      "claim": "C01-decimal-spelling",
      "filter": "*C01DecimalSpellingProbe",
      "seeds": [
        {
          "obligation": "smallest-scale",
          "patch": "seeds/C01-decimal-spelling-smallest-scale.patch",
          "defect": "Neither decimal converter narrows the scale: both write a decimal with the scale it arrived with (7.80, 7.8000)."
        },
        {
          "obligation": "number-is-a-number",
          "patch": "seeds/C01-decimal-spelling-number-is-a-number.patch",
          "defect": "DecimalNumberJsonConverter writes the smallest scale as a string, not as a number."
        },
        {
          "obligation": "string-is-a-string",
          "patch": "seeds/C01-decimal-spelling-string-is-a-string.patch",
          "defect": "DecimalStringJsonConverter writes the smallest scale as a number, not as a string."
        },
        {
          "obligation": "reads-a-number-or-a-string",
          "patch": "seeds/C01-decimal-spelling-reads-a-number-or-a-string.patch",
          "defect": "Both decimal converters refuse a string holding a number."
        },
        {
          "obligation": "keeps-the-scale-it-reads",
          "patch": "seeds/C01-decimal-spelling-keeps-the-scale-it-reads.patch",
          "defect": "Both decimal converters narrow the scale of what they read (7.80 reads as 7.8), as a number or a string."
        },
        {
          "obligation": "covers-every-decimal",
          "patch": "seeds/C01-decimal-spelling-covers-every-decimal.patch",
          "defect": "Both decimal converters write a decimal dictionary key with the scale it arrived with, so a key over a decimal, or over a value object over one, keeps its spellings."
        }
      ]
    },
    "C02OptionalTextProbe": {
      "claim": "C02-optional-text",
