          "obligation": "enum-needs-own-mapping",
          "patch": "seeds/C07-enum-needs-own-mapping.patch",
          "defect": "The startup check skips an endpoint that answers with an unmapped enum, so the host starts."
        },
        {
          "obligation": "member-without-kind-stops-start",
          "patch": "seeds/C07-member-without-kind.patch",
          "defect": "AddFaultResponses() answers a fault-set member of no kind with 500 instead of stopping the start."
