          "patch": "seeds/C02-optional-text-required-blank-is-an-error.patch",
          "defect": "An empty or whitespace-only string passes the guard as empty text; only null is Blank."
        },
        {
          "obligation": "optional-blank-is-no-value",
          "patch": "seeds/C02-optional-text-optional-blank-is-no-value.patch",
          "defect": "AsOptionalText and AsOptionalIdentifier keep Blank a refusal instead of no value."
