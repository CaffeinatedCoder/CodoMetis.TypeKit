        {
          "obligation": "value-converters-unaffected",
          "patch": "seeds/C10-preserve-guard-value-converters-unaffected.patch",
          "defect": "Under ReferenceHandler.Preserve, the guard refuses a value object over any reference type, a string or a Uri written by a value converter included."
