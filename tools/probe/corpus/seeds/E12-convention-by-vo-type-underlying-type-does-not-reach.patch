+/// <summary>A value-object property configured as the type it wraps is: <c>ConfigureConventions</c> by the wrapped type reaches it.</summary>
+internal sealed class WrappedTypeConfigurationConvention : IPropertyAddedConvention
+{
+    public void ProcessPropertyAdded(IConventionPropertyBuilder propertyBuilder, IConventionContext<IConventionPropertyBuilder> context)
+    {
+        var property = propertyBuilder.Metadata;
+        if (ValueObjectTypes.Describe(Nullable.GetUnderlyingType(property.ClrType) ?? property.ClrType) is not { WrappedType: var wrapped }) return;
+#pragma warning disable EF1001
+        ((Microsoft.EntityFrameworkCore.Metadata.Internal.Model)property.DeclaringType.Model).Configuration?.FindProperty(wrapped)?.Apply((Microsoft.EntityFrameworkCore.Metadata.IMutableProperty)property);
+#pragma warning restore EF1001
+    }
