#!/usr/bin/env python3
"""Replays the prober's written probes with no model in the loop.

Per commit it runs only the probes whose footprint the commit changed (`probe-ledger stale`), each
alone and with code coverage, records the result and the fresh footprint, and opens a finding
R-<probe>-<sha> for a probe that passed before and fails now. With --all it replays every probe that
is not promoted, retired ones included: the release run.

It works in one warm worktree kept between runs (obj/ intact), moved to HEAD without --force, so
Metalama and the compiler rebuild only what changed. Builds and tests go through the repository's
verdict script, never raw dotnet.

The corpus is tools/probe/corpus/ (tracked), overlaid by the branch's unpublished staging in the
prober's memory: harness/*.cs and probes/*.cs are copied into probeDir, rows/*.json(.gz) into
probeDir/rows as plain JSON.

Configuration: the "replay" object of the axes file's ```json probe-axes block:
  project             the consumer test project the probes compile into
  probeDir            where the corpus is copied inside the worktree
  build, test         argv templates; {project}, {filter}, {results}, {cobertura} expand
  include             the source roots a footprint keeps (default ["src"])
  compileTimeFootprint paths every probe depends on at compile time (generators, analyzers, package versions)
  coverageTargets     MSBuild targets text that references the coverage extension; written outside the
                      worktree and passed as CustomAfterMicrosoftCommonTargets, so no tracked file changes

A change to a dependency input (the enumerator's inputs or the toolchain) stales every probe through
its compile-time footprint, so the replay after it is a full one, and it also derives the axes again
and reports the settings that appeared or went away. --all always derives them again.

Only one round runs at a time: the replay takes the ledger lock (probe-ledger lock); while another
round holds it, the replay is skipped and noted as owed, and that round's unlock says so.

Usage: tools/probe/probe-replay [--branch B] [--all] [--worktree PATH] [--dry-run] [--where]
Exit 0 when every replayed probe passed, 1 when one failed, 2 on a setup error.
"""
import argparse, glob, hashlib, json, os, shutil, subprocess, sys, tempfile, time

LEDGER = os.path.join(os.path.dirname(os.path.realpath(__file__)), "probe-ledger")


def run(argv, cwd=None, env=None, capture=True):
    return subprocess.run(argv, cwd=cwd, env=env, capture_output=capture, text=True)


def git(*args, cwd=None):
    return run(["git", *args], cwd=cwd)


class Heartbeat:
    """Keeps a lock alive while a long step runs: a thread beats every 30 s (liveness is the heartbeat)."""

    def __init__(self, ledger, holder, cwd):
        import threading
        self.stop = threading.Event()
        def loop():
            while not self.stop.wait(30):
                subprocess.run([ledger, "heartbeat", "--holder", holder], cwd=cwd, capture_output=True)
        self.thread = threading.Thread(target=loop, daemon=True)

    def __enter__(self):
        self.thread.start()
        return self

    def __exit__(self, *exc):
        self.stop.set()


def main():
    ap = argparse.ArgumentParser(description=__doc__, formatter_class=argparse.RawDescriptionHelpFormatter)
    ap.add_argument("--branch")
    ap.add_argument("--all", action="store_true", help="replay every probe that is not promoted (release)")
    ap.add_argument("--worktree")
    ap.add_argument("--dry-run", action="store_true")
    ap.add_argument("--holder", help="run under the ledger lock this holder already took (a full sweep)")
    ap.add_argument("--where", action="store_true", help="print the warm replay and exploration worktree paths and exit")
    args = ap.parse_args()

    common = git("rev-parse", "--path-format=absolute", "--git-common-dir").stdout.strip()
    if not common:
        sys.exit("probe-replay: not inside a git repository")
    repo = os.path.dirname(common)
    top = git("rev-parse", "--show-toplevel").stdout.strip()
    branch = args.branch or git("rev-parse", "--abbrev-ref", "HEAD").stdout.strip()
    head = git("rev-parse", "HEAD").stdout.strip()
    memory = os.environ.get("PROBE_STATE_DIR") or os.path.join(repo, ".claude", "agent-memory-local", "prober")
    text = open(os.path.join(top, ".claude", "probe-axes.md")).read()
    block = json.loads(text.split("```json probe-axes", 1)[1].split("```", 1)[0])
    cfg = block.get("replay")
    if not cfg:
        sys.exit("probe-replay: the axes file's block has no \"replay\" configuration")

    key = hashlib.sha1(repo.encode()).hexdigest()[:8]
    home = os.path.join(os.environ.get("PROBE_CACHE_DIR") or os.path.expanduser("~/.cache/probe-replay"), f"{os.path.basename(repo)}-{key}")
    if args.where:
        print(f"replay:  {os.path.join(home, 'wt')}\nexplore: {os.path.join(home, 'explore')}")
        return 0

    states = json.loads(run([LEDGER, "stale", "--branch", branch, "--json"] + (["--include-retired"] if args.all else []), cwd=top).stdout or "[]")
    todo = states if args.all else [s for s in states if s["replay"]]
    print(f"probe-replay: {branch} at {head[:7]}: {len(todo)} of {len(states)} probes to replay")
    if args.dry_run:
        for s in todo:
            print(f"  {s['probe']}")
        return 0

    wt = os.path.realpath(args.worktree or os.path.join(home, "wt"))
    os.makedirs(home, exist_ok=True)
    holder = args.holder or f"replay-{os.getpid()}"
    # Under a round's lock (--holder) the replay takes nothing: re-locking would tie the round's liveness
    # to this short-lived process. On its own it locks with its own pid.
    if args.holder:
        lock = run([sys.executable, "-c", "import sys; sys.exit(0)"])
    else:
        lock = run([LEDGER, "lock", "--holder", holder, "--mode", "replay", "--pid", str(os.getpid())], cwd=top)
    if lock.returncode:
        # A round holds the ledger: note that a replay is owed (under the lock's mutex), and let its unlock say so.
        run([LEDGER, "owe-replay", "--branch", branch], cwd=top)
        print(f"probe-replay: skipped, {lock.stderr.strip().removeprefix('probe-ledger: ')}")
        return 0
    try:
      with Heartbeat(LEDGER, holder, top):
          axes = rederive(cfg, top, memory, home, force=args.all)
          if axes:
              if axes.get("error"):
                  print(f"  axes: {axes['error']}")
              else:
                  print(f"  axes: re-derived ({len(axes['added'])} added, {len(axes['removed'])} removed)")
                  for a in axes["added"]:
                      print(f"    + {a}")
                  for a in axes["removed"]:
                      print(f"    - {a}")
          if not todo:
              write_summary(memory, branch, {"branch": branch, "commit": head, "replayed": 0, "failed": [], "axes": axes})
              return 0
          return replay(args, cfg, top, repo, memory, branch, head, home, wt, todo, axes)
    finally:
        if not args.holder:
            run([LEDGER, "unlock", "--holder", holder], cwd=top)


def rederive(cfg, top, memory, home, force):
    """Enumerate the generated axes again when a dependency input changed (or always, when forced),
    and say which settings appeared or went away. No exploration: that is a round's job."""
    enum = cfg.get("enumerate")
    if not enum:
        return None
    inputs = [git("rev-parse", "-q", "--verify", f"HEAD:{p}", cwd=top).stdout.strip() for p in enum.get("inputs", [])]
    tool = [run(argv, cwd=top).stdout.strip() for argv in cfg.get("toolchain", {}).values()]
    stamp = hashlib.sha1(json.dumps([inputs, tool]).encode()).hexdigest()
    gen_path = os.path.join(memory, "axes-generated.json")
    old = json.load(open(gen_path)) if os.path.exists(gen_path) else {}
    if not force and old.get("inputsStamp") == stamp:
        return None
    work = os.path.join(home, "enumerate")
    os.makedirs(work, exist_ok=True)
    # The enumerator pins its packages in #:package directives; take each version from the repository's
    # central package versions, so the axes follow a dependency update without anyone editing the script.
    import re
    script = open(os.path.join(top, enum["script"])).read()
    props = os.path.join(top, "Directory.Packages.props")
    versions = dict(re.findall(r'<PackageVersion\s+Include="([^"]+)"\s+Version="([^"]+)"', open(props).read())) if os.path.exists(props) else {}
    script = re.sub(r"^#:package ([^@\s]+)@\S+", lambda m: f"#:package {m.group(1)}@{versions.get(m.group(1), m.group(0).split('@')[1])}",
                    script, flags=re.M)
    with open(os.path.join(work, os.path.basename(enum["script"])), "w") as f:
        f.write(script)
    out = run(["dotnet", "run", os.path.join(work, os.path.basename(enum["script"]))], cwd=work)
    if out.returncode:
        return {"error": "the enumerator failed: " + (out.stderr.strip().splitlines() or ["?"])[-1]}
    new = json.loads(out.stdout[out.stdout.index("{"):])
    new["inputsStamp"] = stamp
    before = {f"{k}={v}" for k, vs in old.get("axes", {}).items() for v in vs} | set(old.get("needsValues", []))
    after = {f"{k}={v}" for k, vs in new.get("axes", {}).items() for v in vs} | set(new.get("needsValues", []))
    with open(gen_path, "w") as f:
        json.dump(new, f, indent=2)
    return {"added": sorted(after - before), "removed": sorted(before - after), "versions": new.get("versions")}


def write_summary(memory, branch, summary):
    d = os.path.join(memory, "branches", branch.replace("/", "-"))
    os.makedirs(d, exist_ok=True)
    with open(os.path.join(d, "replay-last.json"), "w") as f:
        json.dump(summary, f, indent=1)


def replay(args, cfg, top, repo, memory, branch, head, home, wt, todo, axes):
    t0 = time.time()
    if not os.path.isdir(wt):
        out = git("worktree", "add", "--detach", wt, head, cwd=repo)
        if out.returncode:
            print(out.stderr, file=sys.stderr)
            return 2
        warm = "cold"
    else:
        # No --force: files the commits did not change keep their mtimes, so the build stays incremental.
        out = git("-C", wt, "checkout", "--detach", head)
        if out.returncode:
            git("-C", wt, "reset", "--hard", head)
        warm = "warm"

    # A verdict script the commit does not carry yet (its branch is unmerged) comes from PROBE_VERDICT_DIR.
    verdict_dir = os.environ.get("PROBE_VERDICT_DIR")
    if verdict_dir and not os.path.exists(os.path.join(wt, "tools", "build-verdict.sh")):
        os.makedirs(os.path.join(wt, "tools"), exist_ok=True)
        for f in glob.glob(os.path.join(verdict_dir, "build-verdict*")):
            shutil.copy2(f, os.path.join(wt, "tools", os.path.basename(f)))

    probe_dir = os.path.join(wt, cfg["probeDir"])
    os.makedirs(os.path.join(probe_dir, "rows"), exist_ok=True)
    corpus = os.path.join(top, "tools", "probe", "corpus")
    staging = os.path.join(memory, "branches", branch.replace("/", "-"), "staging")
    wanted, rows = {}, {}
    for base in (corpus, staging):                       # staging last: it overlays the tracked corpus
        for sub in ("harness", "probes"):
            for f in glob.glob(os.path.join(base, sub, "*.cs")):
                wanted[os.path.basename(f)] = f
        for f in glob.glob(os.path.join(base, "rows", "*.json")) + glob.glob(os.path.join(base, "rows", "*.json.gz")):
            rows[os.path.basename(f).removesuffix(".gz")] = f
    for name in os.listdir(probe_dir):
        p = os.path.join(probe_dir, name)
        if os.path.isfile(p) and name not in wanted:
            os.remove(p)
    for name, src in wanted.items():
        dst = os.path.join(probe_dir, name)
        if not os.path.exists(dst) or open(src, "rb").read() != open(dst, "rb").read():
            shutil.copy2(src, dst)
    # The corpus as this replay compiles it: a failure is a regression only against the same corpus.
    digest = hashlib.sha1()
    for name in sorted(wanted):
        digest.update(name.encode() + open(wanted[name], "rb").read())
    for name in sorted(rows):
        digest.update(name.encode() + open(rows[name], "rb").read())
    corpus_hash = digest.hexdigest()[:12]
    import gzip
    for name, src in rows.items():
        data = gzip.open(src, "rb").read() if src.endswith(".gz") else open(src, "rb").read()
        dst = os.path.join(probe_dir, "rows", name)
        if not os.path.exists(dst) or open(dst, "rb").read() != data:
            with open(dst, "wb") as f:
                f.write(data)

    env = dict(os.environ)
    if cfg.get("coverageTargets"):
        targets = os.path.join(home, "coverage.targets")
        if not os.path.exists(targets) or open(targets).read() != cfg["coverageTargets"]:
            with open(targets, "w") as f:
                f.write(cfg["coverageTargets"])
        env["CustomAfterMicrosoftCommonTargets"] = targets
    results = tempfile.mkdtemp(prefix="probe-replay-")
    env["PROBE_OUT"] = results

    def expand(template, **kw):
        return [a.format(project=cfg["project"], results=results, **kw) for a in template]

    tb = time.time()
    build = run(expand(cfg["build"]), cwd=wt, env=env)
    build_s = time.time() - tb
    print(f"  build ({warm}): {build_s:.1f} s, {build.stdout.splitlines()[0] if build.stdout else build.returncode}")
    if build.returncode:
        print(build.stdout)
        return 2

    def selected(row, only):
        """The harness's PROBE_ONLY filter, replicated: the rows a variant is expected to run."""
        if not only:
            return True
        for cond in only.split(","):
            if "!=" in cond:
                a, v = cond.split("!=", 1)
                if row.get(a) == v:
                    return False
            else:
                a, v = cond.split("=", 1)
                if row.get(a) != v:
                    return False
        return True

    failed = []
    for s in todo:
        reports, result, secs = [], "pass", 0.0
        claim_rows = json.load(open(os.path.join(probe_dir, "rows", f"{s['claim']}.json")))["rows"]
        evidence = {"variants": [], "rows": {}}
        for i, variant in enumerate(s.get("variants") or [{}]):
            cob = f"{s['probe']}-{i}.cobertura.xml"
            out_dir = os.path.join(results, f"{s['probe']}-{i}-rows")
            venv = {**env, **{k: str(v) for k, v in variant.items()}, "PROBE_OUT": out_dir}
            tr = time.time()
            out = run(expand(cfg["test"], filter=s["filter"], cobertura=cob), cwd=wt, env=venv)
            secs += time.time() - tr
            verdict = out.stdout.splitlines()[0] if out.stdout else f"exit {out.returncode}"
            label = f" [{', '.join(f'{k}={v}' for k, v in variant.items())}]" if variant else ""
            print(f"  {s['probe']}{label}: {verdict} ({time.time() - tr:.1f} s)")
            if out.returncode:
                result = "fail"
                print("\n".join(out.stdout.splitlines()[1:12]))
            reports += glob.glob(os.path.join(results, "**", cob), recursive=True)
            # Execution evidence: the rows this variant should run, the rows it did, how each ended and the
            # settings that applied. A row missing here, or recorded without its settings, earns nothing.
            expected = [n for n, r in enumerate(claim_rows) if selected(r.get("row", r), variant.get("PROBE_ONLY"))]
            executed = []
            for f in glob.glob(os.path.join(out_dir, "*.jsonl")):
                for line in open(f):
                    try:
                        rec_row = json.loads(line)
                    except ValueError:
                        continue
                    executed.append(rec_row["idx"])
                    evidence["rows"][str(rec_row["idx"])] = {"category": rec_row.get("category", "violation"),
                                                             "applied": rec_row.get("applied") or {},
                                                             "reasons": rec_row.get("reasons", [])[:6]}
            evidence["variants"].append({"env": variant, "expected": expected, "executed": sorted(set(executed))})
            missing = sorted(set(expected) - set(executed))
            if missing:
                print(f"    {len(missing)} expected row(s) did not run: {missing[:10]}")
        if result == "fail":
            failed.append(s["probe"])
        ev_path = os.path.join(results, f"{s['probe']}-evidence.json")
        with open(ev_path, "w") as f:
            json.dump(evidence, f)
        cats = {}
        for r in evidence["rows"].values():
            cats[r["category"]] = cats.get(r["category"], 0) + 1
        print("    outcomes: " + ", ".join(f"{k} {v}" for k, v in sorted(cats.items())))
        rec = run([LEDGER, "record-run", "--branch", branch, "--probe", s["probe"], "--result", result, "--seconds", f"{secs:.1f}",
                   "--evidence", ev_path], cwd=top)
        if rec.stdout.strip():
            print("    " + rec.stdout.strip())
        # The footprint is what ran, pass or fail: a probe that keeps failing for an open finding is
        # skipped like any other until its footprint changes (a fix touches it).
        if reports:
            fp = run([LEDGER, "footprint", "--branch", branch, "--probe", s["probe"], "--cobertura", *reports, "--root", wt,
                      "--include", *cfg.get("include", ["src"]),
                      "--compile-time", *cfg.get("compileTimeFootprint", [])], cwd=top)
            print(f"    footprint: {fp.stdout.strip() or fp.stderr.strip()}")
        else:
            print("    footprint: no coverage report found; the probe stays stale", file=sys.stderr)

    summary = {"branch": branch, "commit": head, "build": warm, "build_seconds": round(build_s, 1),
               "replayed": len(todo), "failed": failed, "seconds": round(time.time() - t0, 1), "axes": axes}
    write_summary(memory, branch, summary)
    print(f"probe-replay: {len(todo) - len(failed)} passed, {len(failed)} failed, {summary['seconds']} s in all")
    shutil.rmtree(results, ignore_errors=True)
    return 1 if failed else 0


sys.exit(main())
