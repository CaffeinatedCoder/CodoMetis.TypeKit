{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://codometis.typekit/probe/schemas/run-line.schema.json",
  "title": "Run (one line)",
  "description": "State (runs.jsonl): one replay result of one probe, with the identity it ran under.",
  "type": "object",
  "required": [
    "probe",
    "result",
    "commit"
  ],
  "properties": {
    "schemaVersion": {
      "type": "integer",
      "const": 1,
      "description": "The schema version. A file or line without it is version 1 (the Python baseline)."
    },
    "probe": {
      "type": "string"
    },
    "result": {
      "enum": [
        "pass",
        "fail"
      ]
    },
    "commit": {
      "type": "string"
    },
    "date": {
      "type": "string"
    },
    "seconds": {
      "type": [
        "number",
        "null"
      ]
    },
    "identity": {
      "type": "string"
    }
  }
}
