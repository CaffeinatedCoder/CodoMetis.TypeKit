{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://codometis.typekit/probe/schemas/registry.schema.json",
  "title": "Probe registry",
  "description": "Tracked (corpus/registry.json): every probe, the claim it covers, how to select it, and the process variants it runs in.",
  "type": "object",
  "required": [
    "probes"
  ],
  "properties": {
    "schemaVersion": {
      "type": "integer",
      "const": 1,
      "description": "The schema version. A file or line without it is version 1 (the Python baseline)."
    },
    "probes": {
      "type": "object",
      "additionalProperties": {
        "type": "object",
        "required": [
          "claim",
          "filter"
        ],
        "properties": {
          "claim": {
            "type": "string"
          },
          "filter": {
            "type": "string"
          },
          "variants": {
            "type": "array",
            "items": {
              "type": "object",
              "additionalProperties": {
                "type": "string"
              },
              "description": "Axis name to value, both compared ordinally."
            },
            "description": "one process per environment map"
          },
          "retired": {
            "type": "boolean"
          },
          "seed": {
            "type": "object",
            "required": [
              "defect"
            ],
            "anyOf": [
              {
                "required": [
                  "patch"
                ]
              },
              {
                "required": [
                  "env"
                ]
              }
            ],
            "properties": {
              "patch": {
                "type": "string",
                "description": "A unified diff against the product files (the replay's \"include\"), relative to the corpus directory: seeds/<claim>.patch."
              },
              "env": {
                "type": "object",
                "additionalProperties": {
                  "type": "string"
                },
                "description": "Environment variables set for the seeded build and every variant's run."
              },
              "defect": {
                "type": "string",
                "minLength": 1,
                "description": "What the seed breaks, in one sentence."
              }
            },
            "additionalProperties": false,
            "description": "The product defect `prober seeds` applies in a scratch worktree to prove the probe can fail (decision 100). Not part of the probe's identity."
          }
        },
        "additionalProperties": false
      }
    }
  }
}
