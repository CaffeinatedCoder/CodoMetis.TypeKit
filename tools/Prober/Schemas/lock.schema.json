{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://codometis.typekit/probe/schemas/lock.schema.json",
  "title": "Round lock",
  "description": "State (round.lock): one round at a time. Created exclusively; alive while its heartbeat is recent.",
  "type": "object",
  "required": [
    "holder",
    "mode",
    "since",
    "heartbeat"
  ],
  "properties": {
    "schemaVersion": {
      "type": "integer",
      "const": 1,
      "description": "The schema version. A file or line without it is version 1 (the Python baseline)."
    },
    "holder": {
      "type": "string"
    },
    "mode": {
      "enum": [
        "replay",
        "explore",
        "full"
      ]
    },
    "owner": {
      "type": "object",
      "properties": {
        "pid": {
          "type": [
            "integer",
            "null"
          ]
        },
        "host": {
          "type": "string"
        }
      }
    },
    "since": {
      "type": "number"
    },
    "heartbeat": {
      "type": "number"
    },
    "pending_replay": {
      "type": "boolean"
    }
  }
}
