{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://codometis.typekit/probe/schemas/finding-line.schema.json",
  "title": "Finding event (one line)",
  "description": "State (findings.jsonl): open, fixed or withdrawn. The last line per id wins; a fixed line counts once its commit is in HEAD's history.",
  "type": "object",
  "required": [
    "id",
    "status"
  ],
  "properties": {
    "schemaVersion": {
      "type": "integer",
      "const": 1,
      "description": "The schema version. A file or line without it is version 1 (the Python baseline)."
    },
    "id": {
      "type": "string"
    },
    "claim": {
      "type": [
        "string",
        "null"
      ]
    },
    "status": {
      "enum": [
        "open",
        "fixed",
        "withdrawn",
        "dismissed"
      ]
    },
    "commit": {
      "type": "string"
    },
    "probe": {
      "type": "string"
    },
    "reason": {
      "type": "string"
    }
  }
}
