{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://codometis.typekit/probe/schemas/universe.schema.json",
  "title": "Universe",
  "description": "State (branches/<branch>/universe.json): each claim's axes and values, derived from the claims, the axes file and the generated axes.",
  "type": "object",
  "required": [
    "claims"
  ],
  "properties": {
    "schemaVersion": {
      "type": "integer",
      "const": 1,
      "description": "The schema version. A file or line without it is version 1 (the Python baseline)."
    },
    "base": {
      "type": "string"
    },
    "commit": {
      "type": "string"
    },
    "generated_versions": {
      "type": "object",
      "additionalProperties": {
        "type": "string"
      },
      "description": "Axis name to value, both compared ordinally."
    },
    "claims": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "id",
          "axes"
        ],
        "properties": {
          "id": {
            "type": "string"
          },
          "source": {
            "type": "string"
          },
          "surfaces": {
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "watched": {
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "axes": {
            "type": "object",
            "additionalProperties": {
              "type": "array",
              "items": {
                "type": "string"
              }
            }
          },
          "exclude": {
            "type": "array",
            "items": {
              "type": "array",
              "items": {
                "type": "string",
                "pattern": "^[^=]+=.*$"
              },
              "minItems": 2,
              "maxItems": 2
            }
          },
          "obligations": {
            "type": "array",
            "description": "written only where an obligation of the claim declares where it does not apply: every obligation's id with its declarations, as claims.json holds them, so the covering generator, status and the gate know the pairs each wants",
            "items": {
              "type": "object",
              "required": [
                "id"
              ],
              "properties": {
                "id": {
                  "type": "string"
                },
                "inapplicable": {
                  "type": "array",
                  "items": {
                    "type": "object",
                    "required": [
                      "axes",
                      "cite"
                    ],
                    "properties": {
                      "axes": {
                        "type": "object",
                        "additionalProperties": {
                          "type": "array",
                          "items": {
                            "type": "string"
                          }
                        }
                      },
                      "cite": {
                        "type": "string"
                      }
                    }
                  }
                }
              }
            }
          }
        }
      }
    }
  }
}
