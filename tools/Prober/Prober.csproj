<Project Sdk="Microsoft.NET.Sdk">

    <!--
      prober: the probing workflow's core. It keeps the ledger (claims, universe, covering arrays,
      evidence, coverage, the release gate, the round lock), replays the probe corpus with no model in
      the loop, and runs a capped exploration round. Repository tooling, not a package: BCL only, never
      packed. It is in the solution so `dotnet build` builds it, and it is started as its built dll:

          dotnet tools/Prober/bin/Release/net10.0/prober.dll help

      The file formats are the contract (Schemas/, versioned); this code is one reader of them. Building
      and running probes goes through an adapter (ProbeAdapter.cs), so the core holds nothing of .NET's.
      The README beside this file has the commands.
    -->
    <PropertyGroup>
        <OutputType>Exe</OutputType>
        <AssemblyName>prober</AssemblyName>
        <RootNamespace>Prober</RootNamespace>
        <!-- Never packed: release.yml publishes whatever `dotnet pack` of the solution writes (PackabilityTests). -->
        <IsPackable>false</IsPackable>
        <ToolSourcePatterns>$(ToolSourcePatterns);Schemas/*.json</ToolSourcePatterns>
    </PropertyGroup>

    <ItemGroup>
        <InternalsVisibleTo Include="CodoMetis.TypeKit.Prober.Tests" />
        <None Include="Schemas/*.json" CopyToOutputDirectory="PreserveNewest" />
        <!-- The schemas SchemaCheck reads where a file is read (decision 102), by file name. -->
        <EmbeddedResource Include="Schemas/claims.schema.json" LogicalName="%(Filename)%(Extension)" />
    </ItemGroup>

    <!--
      The dll's own freshness is every tool's: tools/Directory.Build.targets stamps its sources, the
      schemas among them, and at startup tools/Shared/SourceFingerprint.cs refuses to answer from other
      sources (exit 3).
    -->

</Project>
